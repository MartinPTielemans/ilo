<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only where the user types it on purpose: a machine on their own network (Tabs.kt's
     "A machine on the user's own network rarely has a certificate") has no certificate to speak
     https with, while every other address the browser opens keeps Android's cleartext refusal.
     Hosts here are RFC 1918 and link-local ranges plus localhost; WebView honors the config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.0</domain>
        <domain includeSubdomains="false">172.16.0.0</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">169.254.0.0</domain>
    </domain-config>
</network-security-config>