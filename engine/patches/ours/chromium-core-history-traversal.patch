+// browser_core: lets the core say which of a tab's session history entries it may be taken to.
+
+#ifndef CONTENT_PUBLIC_BROWSER_HISTORY_TRAVERSAL_H_
+#define CONTENT_PUBLIC_BROWSER_HISTORY_TRAVERSAL_H_
+
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+
+namespace content {
+
+class WebContents;
+
+// Asked with the index of the session history entry a tab is about to be taken to, whoever asks:
+// the browser's back, forward and go to an entry, a page's history.back(), forward() and go(), and
+// the Navigation API's back(), forward() and traverseTo(). False leaves the tab on its page.
+using HistoryTraversalFilter = base::RepeatingCallback<bool(int index)>;
+
+// Has |contents| ask |filter| from now on, or nothing if it's null, as a tab starts.
+CONTENT_EXPORT void SetHistoryTraversalFilter(WebContents* contents, HistoryTraversalFilter filter);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_HISTORY_TRAVERSAL_H_
