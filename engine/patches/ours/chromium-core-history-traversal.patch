   CHECK_LT(static_cast<size_t>(index), entries_.size());
 
+  // browser_core: every traversal comes through here, the browser's own, a
+  // page's history.go() and the Navigation API's alike, so the embedder is
+  // asked here (history_traversal.h). One it refuses doesn't start, and a
+  // Navigation API caller hears so, as for an entry that isn't there.
+  if (history_traversal_filter_ && !history_traversal_filter_.Run(index)) {
+    if (initiator_rfh && navigation_api_key) {
+      initiator_rfh->GetAssociatedLocalFrame()->TraverseCancelled(
+          *navigation_api_key,
+          blink::mojom::TraverseCancelledReason::kNotFound);
+    }
+    return {};
+  }
+
   if (entries_[index]->IsInitialEntryNotForSynchronousAboutBlank()) {
     // We should never navigate to an existing initial NavigationEntry that is
     // the initial NavigationEntry for the initial empty document that hasn't
@@ -5951,6 +5965,17 @@
              features::kReplaceInitialEntryForReload) &&
          reload_type != ReloadType::NONE &&
          GetLastCommittedEntry()->IsInitialEntryNotForSynchronousAboutBlank();
+}
+
+void NavigationControllerImpl::SetHistoryTraversalFilter(
+    base::RepeatingCallback<bool(int)> filter) {
+  history_traversal_filter_ = std::move(filter);
+}
+
+void SetHistoryTraversalFilter(WebContents* contents,
+                               HistoryTraversalFilter filter) {
+  static_cast<NavigationControllerImpl&>(contents->GetController())
+      .SetHistoryTraversalFilter(std::move(filter));
 }
 
