             'win': {
-                'reg_mandatory_key_name': 'Software\\Policies\\Chromium',
+                # browser_core: the key the loader reads (generate_policy_source.py).
+                'reg_mandatory_key_name': 'Software\\Policies\\ilo',
                 'reg_recommended_key_name':
-                'Software\\Policies\\Chromium\\Recommended',
+                'Software\\Policies\\ilo\\Recommended',
                 'mandatory_category_path': ['chromium'],
