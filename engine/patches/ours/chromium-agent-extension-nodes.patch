+bool DOMWrapperWorld::IsExtensionWorld(
+    const base::UnguessableToken& cluster_id) const {
+  if (world_type_ != WorldType::kIsolated || !IsMainThread()) {
+    return false;
+  }
+  scoped_refptr<const SecurityOrigin> origin =
+      GetIsolatedWorldSecurityOrigin(GetWorldId(), cluster_id);
+  return origin && origin->Protocol() == "chrome-extension";
+}
