Leaves the invitations another user sends to share a password out of what the Passwords choice
syncs, so a device never asks the server for them. Chromium never encrypts them under the
passphrase, so the account's server could write one, and Chromium would add its login to the
password manager. The outgoing ones stay, as //browser_core/sync_guard.cc holds each one back.

--- a/components/sync/base/user_selectable_type.cc
+++ b/components/sync/base/user_selectable_type.cc
@@ -73,8 +73,9 @@
       return {
           kPasswordsTypeName,
           PASSWORDS,
-          {PASSWORDS, WEBAUTHN_CREDENTIAL, INCOMING_PASSWORD_SHARING_INVITATION,
-           OUTGOING_PASSWORD_SHARING_INVITATION}};
+          // browser_core: no invitation from another user. One comes in plain
+          // text, which the account's server could write.
+          {PASSWORDS, WEBAUTHN_CREDENTIAL, OUTGOING_PASSWORD_SHARING_INVITATION}};
     case UserSelectableType::kAutofill:
       return {kAutofillTypeName,
               AUTOFILL,
