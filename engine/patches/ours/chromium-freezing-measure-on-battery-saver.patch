+// browser_core: measures only while Battery Saver is on. Only then can a CPU measurement freeze a
+// page, and the memory one only discards frozen pages that grow, which outside Battery Saver only a
+// freeze vote makes. A measurement started again begins a new first interval.
+void FreezingPolicy::UpdateResourceUsageQuery() {
+  const bool measures =
+      is_battery_saver_active_ &&
+      (base::FeatureList::IsEnabled(features::kCPUMeasurementInFreezingPolicy) ||
+       base::FeatureList::IsEnabled(
+           features::kMemoryMeasurementInFreezingPolicy));
+  if (measures == resource_usage_query_.has_value()) {
+    return;
+  }
+  if (!measures) {
+    resource_usage_query_observation_.Reset();
+    resource_usage_query_.reset();
+    cpu_proportion_tracker_.Stop();
+    return;
+  }
+  resource_attribution::QueryBuilder builder;
+  builder.AddAllContextsOfType<OriginInBrowsingInstanceContext>();
+  if (base::FeatureList::IsEnabled(features::kCPUMeasurementInFreezingPolicy)) {
+    builder.AddResourceType(resource_attribution::ResourceType::kCPUTime);
+  }
+  if (base::FeatureList::IsEnabled(
+          features::kMemoryMeasurementInFreezingPolicy)) {
+    builder.AddResourceType(resource_attribution::ResourceType::kMemorySummary);
+  }
+  resource_usage_query_ = builder.CreateScopedQuery();
+  resource_usage_query_observation_.Observe(&resource_usage_query_.value());
+  resource_usage_query_->Start(kCPUMeasurementInterval);
+}
