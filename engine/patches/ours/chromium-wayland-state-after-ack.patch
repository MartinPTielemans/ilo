+
+bool WaylandToplevelWindow::StateRequestsSettled() const {
+  return !state_sync_ && !HasInFlightRequestsForStateForTesting();
+}
+
+void WaylandToplevelWindow::StartStateSync() {
+  static constexpr wl_callback_listener kStateSyncListener = {
+      .done = &OnStateSync};
+  state_sync_.reset(connection()->GetSyncCallback());
+  wl_callback_add_listener(state_sync_.get(), &kStateSyncListener, this);
+}
+
+// static
+void WaylandToplevelWindow::OnStateSync(void* data,
+                                        wl_callback* callback,
+                                        uint32_t time) {
+  auto* window = static_cast<WaylandToplevelWindow*>(data);
+  window->state_sync_.reset();
+  // The configures the request brought, if any, are in flight now, and the
+  // held state waits for their frame.
+  window->MaybeSendHeldState();
+}
+
+void WaylandToplevelWindow::MaybeSendHeldState() {
+  if (!held_state_ || !xdg_toplevel_ || !StateRequestsSettled()) {
+    return;
+  }
+  const HeldState held = *held_state_;
+  held_state_.reset();
+  // Settled, the last configure says the state the compositor has.
+  const PlatformWindowState from = last_configured_window_state_;
+  if (held.window_state == from) {
+    return;
+  }
+  if (held.window_state == PlatformWindowState::kFullScreen) {
+    xdg_toplevel_->SetFullscreen(
+        GetWaylandOutputForDisplayId(held.display_id));
+  } else if (held.window_state == PlatformWindowState::kMaximized) {
+    if (from == PlatformWindowState::kFullScreen) {
+      xdg_toplevel_->UnSetFullscreen();
+    }
+    xdg_toplevel_->SetMaximized();
+  } else if (held.window_state == PlatformWindowState::kNormal) {
+    if (from == PlatformWindowState::kFullScreen) {
+      xdg_toplevel_->UnSetFullscreen();
+    } else if (from == PlatformWindowState::kMaximized) {
+      xdg_toplevel_->UnSetMaximized();
+    }
+  }
+  StartStateSync();
+  connection()->Flush();
 }
 
