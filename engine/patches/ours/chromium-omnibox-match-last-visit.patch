Gives an address bar match made from a history row that row's last visit, as a time, so the
core's suggestions can say "Visited yesterday" (#2337). The two history providers hold the row
and record the visit only as about:omnibox's debug text; nothing else changes. The core's
omnibox_last_visit_unittest.cc fails if a rebase loses it.

--- a/components/omnibox/browser/autocomplete_match.cc
+++ b/components/omnibox/browser/autocomplete_match.cc
@@ -256,6 +256,7 @@
     : provider(match.provider),
       relevance(match.relevance),
       typed_count(match.typed_count),
+      last_visit(match.last_visit),
       deletable(match.deletable),
       fill_into_edit(match.fill_into_edit),
       additional_text(match.additional_text),
@@ -330,6 +331,7 @@
   provider = std::move(match.provider);
   relevance = std::move(match.relevance);
   typed_count = std::move(match.typed_count);
+  last_visit = std::move(match.last_visit);
   deletable = std::move(match.deletable);
   fill_into_edit = std::move(match.fill_into_edit);
   additional_text = std::move(match.additional_text);
@@ -411,6 +413,7 @@
   provider = match.provider;
   relevance = match.relevance;
   typed_count = match.typed_count;
+  last_visit = match.last_visit;
   deletable = match.deletable;
   fill_into_edit = match.fill_into_edit;
   additional_text = match.additional_text;
