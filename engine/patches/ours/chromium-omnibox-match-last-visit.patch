 #include "components/omnibox/browser/actions/omnibox_action_concepts.h"
@@ -863,6 +864,12 @@
   // set for matches from HistoryURL and HistoryQuickProvider.
   int typed_count = -1;
 
+  // browser_core: when the profile's history last saw a visit to the page,
+  // from the history row the match was made from: set by HistoryURL and
+  // HistoryQuickProvider, null for every other match. The address bar's rows
+  // say "Visited yesterday" from it.
