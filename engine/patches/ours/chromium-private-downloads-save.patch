Lets a private session save its downloads as its profile does: to the profile's folder, asking
where only if the profile asks. Chrome reads both from the session's own prefs, which for ilo's
private sessions gave ungoogled-chromium's default, ask, and the system's Downloads folder, so
each private download waited in a Save File dialog where a regular window's saved at once. The
core's own off-the-record profiles, which aren't the primary one, keep Chrome's behaviour.

--- a/chrome/browser/download/download_prefs.cc
+++ b/chrome/browser/download/download_prefs.cc
@@ -276,14 +276,20 @@
     }
   }
 
-  prompt_for_download_.Init(prefs::kPromptForDownload, prefs);
+  // browser_core: a private session asks where to save, and saves to, what its
+  // profile does. Its own prefs don't give the profile's values: it asked, as
+  // ungoogled-chromium's default does, and offered the system's folder.
+  PrefService* saving = profile->IsPrimaryOTRProfile()
+                            ? profile->GetOriginalProfile()->GetPrefs()
+                            : prefs;
+  prompt_for_download_.Init(prefs::kPromptForDownload, saving);
 #if BUILDFLAG(IS_ANDROID)
   prompt_for_download_android_.Init(prefs::kPromptForDownloadAndroid, prefs);
   RecordDownloadPromptStatus(
       static_cast<DownloadPromptStatus>(*prompt_for_download_android_));
   auto_open_pdf_enabled_.Init(prefs::kAutoOpenPdfEnabled, prefs);
 #endif
-  download_path_.Init(prefs::kDownloadDefaultDirectory, prefs);
+  download_path_.Init(prefs::kDownloadDefaultDirectory, saving);
   save_file_path_.Init(prefs::kSaveFileDefaultDirectory, prefs);
   save_file_type_.Init(prefs::kSaveFileType, prefs);
   safebrowsing_for_trusted_sources_enabled_.Init(
