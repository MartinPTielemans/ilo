+void NetErrorTabHelper::SetGameRunning(bool running) {
+  // Only the tab's own error page holds its reload. One on its way out ends
+  // its run as it goes, which is no bad message.
+  content::RenderFrameHost& target_frame =
+      network_easter_egg_receivers_.CurrentTargetFrame();
+  if (!target_frame.IsErrorDocument() || !target_frame.IsInPrimaryMainFrame()) {
+    return;
+  }
+  if (g_browser_core_offline_game) {
+    g_browser_core_offline_game(web_contents(), running);
+  }
+}
