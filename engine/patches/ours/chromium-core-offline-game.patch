+bool NetErrorAutoReloader::HoldReload(content::NavigationHandle* handle,
+                                      base::OnceClosure resume) {
+  // browser_core: the throttle is on any navigation to the error page's URL
+  // while an auto-reload is under way, a user's own reload or an agent's too;
+  // only the auto-reload's is held.
+  if (!held_ || auto_reload_navigation_ != handle->GetNavigationId()) {
+    return false;
+  }
+  resume_held_reload_ = std::move(resume);
+  return true;
 }
 
