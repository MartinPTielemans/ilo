+void WaylandWindowManager::SetEmbedderTextInputSurface(
+    wl_surface* surface,
+    gfx::AcceleratedWidget widget) {
+  auto it = embedder_text_input_surfaces_.find(surface);
+  if (it != embedder_text_input_surfaces_.end() && it->second != widget &&
+      text_input_focus_for_embedder_ &&
+      text_input_focused_window_ == GetWindow(it->second)) {
+    // The surface has the focus now, so the window it composed through loses
+    // it: the compositor's next enter for the surface names the new one.
+    SetTextInputFocusedWindow(nullptr);
+  }
+  if (widget == gfx::kNullAcceleratedWidget) {
+    embedder_text_input_surfaces_.erase(surface);
+  } else {
+    embedder_text_input_surfaces_[surface] = widget;
+  }
+}
+
+WaylandWindow* WaylandWindowManager::GetEmbedderTextInputWindow(
+    wl_surface* surface) const {
+  auto it = embedder_text_input_surfaces_.find(surface);
+  return it == embedder_text_input_surfaces_.end() ? nullptr
+                                                   : GetWindow(it->second);
+}
