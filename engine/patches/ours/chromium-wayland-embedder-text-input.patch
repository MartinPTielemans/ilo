+  // gfx::kNullAcceleratedWidget no longer. Set before |surface| can take the
+  // keyboard, and ended before destroying it. Removing the window ends it too.
+  virtual void SetEmbedderTextInputSurface(wl_surface* surface,
+                                           gfx::AcceleratedWidget widget) {}
