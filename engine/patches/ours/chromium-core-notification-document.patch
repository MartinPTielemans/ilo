--- a/content/browser/notifications/notification_event_dispatcher_impl.cc
+++ b/content/browser/notifications/notification_event_dispatcher_impl.cc
@@ -546,6 +546,22 @@
                             creator_type));
 }
 
+// browser_core: unlike the listeners above, the document is returned even
+// when it sits in back/forward cache, because the core counts a notification
+// as soon as Chromium displays it, not when the page hears the show event.
+RenderFrameHost*
+NotificationEventDispatcherImpl::GetNonPersistentNotificationDocument(
+    const std::string& notification_id) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI, base::NotFatalUntil::M159);
+  auto it = non_persistent_notification_listeners_.find(notification_id);
+  if (it == non_persistent_notification_listeners_.end() ||
+      it->second.creator_type !=
+          RenderProcessHost::NotificationServiceCreatorType::kDocument) {
+    return nullptr;
+  }
+  return it->second.document.AsRenderFrameHostIfValid();
+}
+
 // Only fire the notification listeners (including show, click and
 // close) when it exists in the map and the document is currently
 // not in back/forward cache.