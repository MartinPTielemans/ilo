 // Helper to create the prompt body view based on the Ask-before-HTTP warning
 // type.
+// browser_core: the paragraph |message_id|, which names the browser at $2: by
+// the app's name for it, or else by the name the text had.
+ui::DialogModelLabel NamingTheBrowser(
+    int message_id,
+    ui::DialogModelLabel::TextReplacement link) {
+  std::u16string product = g_browser_core_product_name
+                               ? g_browser_core_product_name()
+                               : std::u16string();
+  if (product.empty()) {
+    product = u"Chrome";
+  }
+  return ui::DialogModelLabel::CreateWithReplacements(
+      message_id,
+      {link, ui::DialogModelLabel::CreatePlainText(std::move(product))});
+}
