+#include "browser_core/hooks.h"  // nogncheck
 
 #include "base/feature_list.h"
 #include "chrome/browser/ssl/ask_before_http_dialog_controller.h"
@@ -14,6 +15,11 @@
 #include "content/public/browser/web_contents.h"
 #include "url/gurl.h"
 
+// browser_core: an agent's tab has no warning before http
+// (//browser_core/hooks.h).
+bool (*g_browser_core_no_http_warning)(content::WebContents* contents,
+                                       const GURL& url) = nullptr;
+
 HttpsOnlyModeTabHelper::~HttpsOnlyModeTabHelper() = default;
 
