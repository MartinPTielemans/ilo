+// ilo: see withheld_values.h.
+
+#include "third_party/blink/renderer/core/html/forms/withheld_values.h"
+
+#include <utility>
+
+#include "third_party/blink/renderer/core/core_probe_sink.h"
+#include "third_party/blink/renderer/core/dom/attribute_collection.h"
+#include "third_party/blink/renderer/core/dom/container_node.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/node_traversal.h"
+#include "third_party/blink/renderer/core/dom/shadow_root.h"
+#include "third_party/blink/renderer/core/dom/text.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/html/forms/html_input_element.h"
+#include "third_party/blink/renderer/core/html/forms/text_control_element.h"
+#include "third_party/blink/renderer/core/html_names.h"
+#include "third_party/blink/renderer/core/probe/core_probes.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_map.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_vector.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/heap/member.h"
+#include "third_party/blink/renderer/platform/heap/persistent.h"
+#include "third_party/blink/renderer/platform/weborigin/kurl.h"
+#include "third_party/blink/renderer/platform/wtf/hash_set.h"
+#include "third_party/blink/renderer/platform/wtf/std_lib_extras.h"
+
+namespace blink {
+
+namespace {
+
+// As the core's floor: a value shorter than this, which ordinary words hold by chance, shows only
+// as all of a text.
+constexpr unsigned kAnywhere = 6;
+constexpr wtf_size_t kMostFields = 16;
+
+// The last value a field held, and whether it's open: kept or changed since the last freeze, to
+// one no freeze in the document looked for.
+class WithheldValue final : public GarbageCollected<WithheldValue> {
+ public:
+  WithheldValue(const HTMLInputElement& field, const String& value)
+      : field(&field), value(value) {}
+
+  void Trace(Visitor* visitor) const { visitor->Trace(field); }
+
+  // Weak: the value stays kept after the field goes.
+  WeakMember<const HTMLInputElement> field;
+  String value;
+  bool open = true;
+};
+
+class WithheldRecord final : public GarbageCollected<WithheldRecord> {
+ public:
+  void Trace(Visitor* visitor) const { visitor->Trace(values); }
+
+  bool Holds(const Element& element) const {
+    for (const auto& kept : values) {
+      if (kept->field == &element) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  HeapVector<Member<WithheldValue>> values;
+  // Every value a freeze looked for in the document: one held again, by any field, stays closed,
+  // so a page can't be made to look again and again for what it already showed or didn't.
+  HashSet<String> frozen;
+  // An open value went unlooked to make room, so the next freeze answers that it shows.
+  bool lost_open = false;
+};
+
+// The GCed kind, which MakeGarbageCollected takes; HeapHashMap lives inside another object.
+using Records = GCedHeapHashMap<WeakMember<const Document>, Member<WithheldRecord>>;
+
+Records& AllRecords() {
+  DEFINE_STATIC_LOCAL(Persistent<Records>, records, (MakeGarbageCollected<Records>()));
+  return *records;
+}
+
+bool Shows(const String& text, const String& value) {
+  if (value.length() >= kAnywhere) {
+    return text.contains(value);
+  }
+  return text.StripWhiteSpace() == value;
+}
+
+// Whether |text| shows one of |record|'s open values, as it is or URL-unescaped: the same rule as
+// the core's ShowsPassword (//browser_core/agent_sign_in_rule.cc), which Blink can't link.
+bool ShowsOpen(const WithheldRecord& record, const String& text) {
+  if (text.empty()) {
+    return false;
+  }
+  // As a form sent with GET puts a field in an address: escaped, with a space as +.
+  String unescaped;
+  String plus;
+  if (text.contains('%') || text.contains('+')) {
+    unescaped = DecodeUrlEscapeSequences(text, DecodeUrlMode::kUtf8OrIsomorphic);
+    String spaced = text;
+    spaced.Replace(u'+', u' ');
+    plus = DecodeUrlEscapeSequences(spaced, DecodeUrlMode::kUtf8OrIsomorphic);
+  }
+  for (const auto& kept : record.values) {
+    if (kept->open &&
+        (Shows(text, kept->value) || (!unescaped.IsNull() && Shows(unescaped, kept->value)) ||
+         (!plus.IsNull() && Shows(plus, kept->value)))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// One look at the document outside the fields that held the values.
+bool Walk(const Document& document, const WithheldRecord& record) {
+  if (ShowsOpen(record, document.title()) || ShowsOpen(record, document.Url().GetString())) {
+    return true;
+  }
+  HeapVector<Member<const ContainerNode>> roots;
+  roots.push_back(&document);
+  while (!roots.empty()) {
+    const ContainerNode* root = roots.back();
+    roots.pop_back();
+    for (const Node& node : NodeTraversal::DescendantsOf(*root)) {
+      if (const auto* text = DynamicTo<Text>(node)) {
+        if (ShowsOpen(record, text->data())) {
+          return true;
+        }
+        continue;
+      }
+      const auto* element = DynamicTo<Element>(node);
+      if (!element) {
+        continue;
+      }
+      const bool field = record.Holds(*element);
+      for (const Attribute& attribute : element->Attributes()) {
+        // A field's own value attribute is where its value came from, not a copy.
+        if (field && attribute.GetName() == html_names::kValueAttr) {
+          continue;
+        }
+        if (ShowsOpen(record, attribute.Value())) {
+          return true;
+        }
+      }
+      // A text control's text is in its own user-agent shadow tree: its value is read instead.
+      if (const auto* control = DynamicTo<TextControlElement>(element)) {
+        if (!field && ShowsOpen(record, control->Value())) {
+          return true;
+        }
+        continue;
+      }
+      if (const ShadowRoot* shadow = element->GetShadowRoot()) {
+        roots.push_back(shadow);
+      }
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+void RecordWithheldValue(HTMLInputElement& input, const String& value) {
+  if (value.empty() || !input.HasBeenPasswordField()) {
+    return;
+  }
+  Document& document = input.GetDocument();
+  // An agent's tab only: the core turns DOM on in its DevTools session there as it attaches, and
+  // DevTools turns it on again in a frame's new renderer before its page runs. The user's own
+  // DevTools counts too, which keeps a value only while it's open.
+  LocalFrame* frame = document.GetFrame();
+  if (!frame || !probe::ToCoreProbeSink(frame) ||
+      !probe::ToCoreProbeSink(frame)->HasInspectorDOMAgents()) {
+    return;
+  }
+  auto it = AllRecords().find(&document);
+  WithheldRecord* record = it == AllRecords().end() ? nullptr : it->value.Get();
+  if (!record) {
+    record = MakeGarbageCollected<WithheldRecord>();
+    AllRecords().Set(&document, record);
+  }
+  const bool looked = record->frozen.Contains(value);
+  for (auto& kept : record->values) {
+    if (kept->field == &input) {
+      if (kept->value != value) {
+        kept->value = value;
+        kept->open = !looked;
+      }
+      return;
+    }
+  }
+  if (record->values.size() == kMostFields) {
+    // The oldest closed value goes, which |frozen| keeps; with none closed, the oldest open one,
+    // and the next freeze answers yes for it.
+    wtf_size_t drop = 0;
+    for (wtf_size_t i = 0; i < record->values.size(); ++i) {
+      if (!record->values[i]->open) {
+        drop = i;
+        break;
+      }
+    }
+    record->lost_open = record->lost_open || record->values[drop]->open;
+    record->values.EraseAt(drop);
+  }
+  auto* kept = MakeGarbageCollected<WithheldValue>(input, value);
+  kept->open = !looked;
+  record->values.push_back(kept);
+}
+
+bool FreezeWithheldValues(Document& document) {
+  auto it = AllRecords().find(&document);
+  if (it == AllRecords().end()) {
+    return false;
+  }
+  WithheldRecord& record = *it->value;
+  bool open = record.lost_open;
+  for (const auto& kept : record.values) {
+    open = open || kept->open;
+  }
+  if (!open) {
+    return false;
+  }
+  const bool shows = record.lost_open || Walk(document, record);
+  record.lost_open = false;
+  for (auto& kept : record.values) {
+    if (kept->open) {
+      record.frozen.insert(kept->value);
+      kept->open = false;
+    }
+  }
+  return shows;
+}
+
