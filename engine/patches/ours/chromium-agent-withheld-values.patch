@@ -0,0 +1,30 @@
+// ilo: whether a document shows, anywhere outside the field, what one of its password fields held,
+// for the core's agent (//browser_core/agent_page.cc). Kept only in an agent's tab, in the
+// renderer: never sent anywhere, logged or put in a crash key.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_FORMS_WITHHELD_VALUES_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_FORMS_WITHHELD_VALUES_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+class Document;
+class HTMLInputElement;
+
+// Keeps |value| as the last that |input| held, if it is or was a password field and the core's
+// DevTools session has DOM on in its frame, as it does in an agent's tab. A value kept or changed
+// is open until the next FreezeWithheldValues, unless a freeze already looked for it in the
+// document. At most 16 fields a document, for as long as it lives: past that a closed value makes
+// room, or else an open one, and the next freeze answers true for it.
+void RecordWithheldValue(HTMLInputElement& input, const String& value);
+
+// Whether |document| shows, anywhere outside the field, one of its open values. Then none is
+// looked for again in the document, whichever field holds it next. A document with no open value
+// answers false at once.
+CORE_EXPORT bool FreezeWithheldValues(Document& document);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_FORMS_WITHHELD_VALUES_H_
