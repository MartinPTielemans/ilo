+protocol::Response InspectorDOMAgent::freezeWithheldValues(bool* shows) {
+  *shows = false;
+  // Every document of the target is walked, so each is frozen, whichever shows one.
+  for (LocalFrame* frame : *inspected_frames_) {
+    if (Document* document = frame->GetDocument()) {
+      *shows = FreezeWithheldValues(*document) || *shows;
+    }
+  }
+  return protocol::Response::Success();
+}
