A new profile writes every login with OSCryptAsync from the start, so its stores are marked moved
before they open; else the move re-saves each synced login a minute in and undoes removals (#3949).

--- a/chrome/browser/profiles/profile_impl.cc
+++ b/chrome/browser/profiles/profile_impl.cc
@@ -147,6 +147,7 @@
 #include "components/language/core/common/locale_util.h"
 #include "components/metrics/metrics_service.h"
 #include "components/omnibox/browser/autocomplete_classifier.h"
+#include "components/password_manager/core/common/password_manager_pref_names.h"
 #include "components/payments/core/payment_request_metrics.h"
 #include "components/permissions/permission_manager.h"
 #include "components/policy/core/common/cloud/cloud_policy_manager.h"
@@ -1149,6 +1150,18 @@
 
   // Migrate obsolete prefs.
   MigrateObsoleteProfilePrefs(GetPrefs(), GetPath());
+  // A new profile's stores write every login with OSCryptAsync from the start,
+  // so they're marked moved before they open, or the move would re-save each
+  // login sync brought a minute in, and sync would send those out as changes.
+  if (GetPrefs()->GetInitializationStatus() ==
+      PrefService::INITIALIZATION_STATUS_CREATED_NEW_PREF_STORE) {
+    CHECK(!ProfilePasswordStoreFactory::HasStore(this));
+    CHECK(!AccountPasswordStoreFactory::HasStore(this));
+    GetPrefs()->SetBoolean(
+        password_manager::prefs::kProfileStoreMigratedToOSCryptAsync, true);
+    GetPrefs()->SetBoolean(
+        password_manager::prefs::kAccountStoreMigratedToOSCryptAsync, true);
+  }
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   // Note: Extension preferences can be keyed off the extension ID, so need to
   // be handled specially (rather than directly as part of
