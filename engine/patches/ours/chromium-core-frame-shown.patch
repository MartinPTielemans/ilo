   blink_widget_->ForceRedraw(base::DoNothing());
 }
 
+void RenderWidgetHostImpl::CallWhenFrameShown(base::OnceClosure shown) {
+  // Answered once the renderer's next frame has been presented, which the renderer draws
+  // only once it's visible.
+  if (blink_widget_) {
+    blink_widget_->ForceRedraw(std::move(shown));
+  }
+}
+
 void RenderWidgetHostImpl::SetIsDiscarding(bool is_discarding) {
   if (is_discarding_ == is_discarding) {
     return;
@@ -4680,6 +4689,12 @@
         "Navigation.SwapRFHToCompositorCreation",
         create_frame_sink_timestamp_ - swap_rfh_timestamp_,
         base::Milliseconds(1), base::Minutes(10), 50);
+  }
+}
+
+void CallWhenFrameShown(RenderWidgetHostView* view, base::OnceClosure shown) {
+  if (RenderWidgetHost* host = view ? view->GetRenderWidgetHost() : nullptr) {
+    RenderWidgetHostImpl::From(host)->CallWhenFrameShown(std::move(shown));
   }
 }
 
