+// browser_core: lets the core keep the page a switch leaves over a view until the view has drawn.
+
+#ifndef CONTENT_PUBLIC_BROWSER_FRAME_SHOWN_H_
+#define CONTENT_PUBLIC_BROWSER_FRAME_SHOWN_H_
+
+#include "base/functional/callback_forward.h"
+#include "content/common/content_export.h"
+
+namespace content {
+
+class RenderWidgetHostView;
+
+// Runs |shown| once |view|'s page has drawn a frame since, and that frame has reached the screen,
+// or never if the page goes first. A page shown again shows only its background until then.
+CONTENT_EXPORT void CallWhenFrameShown(RenderWidgetHostView* view, base::OnceClosure shown);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_FRAME_SHOWN_H_
