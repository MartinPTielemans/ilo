@@ -219,8 +220,19 @@
 
   // Update the contents that the NSView is displaying.
   ns_view_->SetCALayerParams(std::move(ca_layer_params));
+  // browser_core: in the same Core Animation transaction as the frame, so what the callbacks
+  // change on screen changes with it.
+  std::vector<base::OnceClosure> shown;
+  shown.swap(frame_shown_callbacks_);
+  for (base::OnceClosure& callback : shown) {
+    std::move(callback).Run();
+  }
 }
 
+void RenderWidgetHostViewMac::CallWhenFrameShown(base::OnceClosure shown) {
+  frame_shown_callbacks_.push_back(std::move(shown));
+}
