--- /dev/null
+++ b/content/public/browser/frame_shown_mac.h
@@ -0,0 +1,20 @@
+// browser_core: lets the core keep the page a switch leaves over a view until the view has drawn.
+
+#ifndef CONTENT_PUBLIC_BROWSER_FRAME_SHOWN_MAC_H_
+#define CONTENT_PUBLIC_BROWSER_FRAME_SHOWN_MAC_H_
+
+#include "base/functional/callback_forward.h"
+#include "content/common/content_export.h"
+
+namespace content {
+
+class RenderWidgetHostView;
+
+// Runs |shown| once |view| next puts a frame in its NSView, in the same Core Animation transaction,
+// or never if the view goes first. A view shown again gets a new compositor, and shows nothing
+// until it draws.
+CONTENT_EXPORT void CallWhenFrameShown(RenderWidgetHostView* view, base::OnceClosure shown);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_FRAME_SHOWN_MAC_H_
