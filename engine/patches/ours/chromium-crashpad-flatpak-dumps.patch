+// browser_core: in the Flatpak, zypak starts sandboxed processes in a pid namespace of
+// their own, where the handler's pid names no process, or another one, and Chromium may pass no pid
+// at all, so naming the handler this process's ptracer can't work. Such a process allows any
+// ptracer instead, while its sandbox isn't on yet, so the handler can read it through /proc. That
+// opens it to the app's own processes; the user's processes on the host could read it already, as
+// the user owns the Flatpak's user namespace.
+bool AllowAnyPtracer(pid_t pid) {
+  if (pid < 0 || access("/.flatpak-info", F_OK) != 0) {
+    return false;
+  }
+  if (pid == 0) {
+    return true;
+  }
+  char path[32];
+  snprintf(path, sizeof(path), "/proc/%d/comm", pid);
+  ScopedFileHandle comm_file(HANDLE_EINTR(open(path, O_RDONLY | O_CLOEXEC)));
+  char comm[16] = {};
+  // A process's name is its file's first 15 bytes: chrome_crashpad_handler's.
+  return !comm_file.is_valid() ||
+         ReadFile(comm_file.get(), comm, sizeof(comm) - 1) <= 0 ||
+         strncmp(comm, "chrome_crashpad", 15) != 0;
+}
