+// browser_core: whether every thread of pid is stopped, from each one's state in
+// /proc/<pid>/task/<tid>/stat, the letter after the parenthesised name.
+bool AllThreadsStopped(pid_t pid) {
+  std::vector<pid_t> threads;
+  if (!ReadThreadIDs(pid, &threads)) {
+    return false;
+  }
+  for (pid_t tid : threads) {
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%d/task/%d/stat", pid, tid);
+    std::string stat;
+    if (!LoggingReadEntireFile(base::FilePath(path), &stat)) {
+      return false;
+    }
+    size_t end = stat.rfind(')');
+    if (end == std::string::npos || end + 2 >= stat.size() ||
+        (stat[end + 2] != 'T' && stat[end + 2] != 't')) {
+      return false;
+    }
+  }
+  return true;
+}
