+class PaintedScrollbarLayerImplFluentTest
+    : public PaintedScrollbarLayerImplSolidColorThumbTest {
+ protected:
+  void SetUp() override {
+    LayerTreeSettings settings = CommitToPendingTreeLayerListSettings();
+    settings.enable_fluent_scrollbar = true;
+    impl_ = std::make_unique<LayerTreeImplTestBase>(settings);
+  }
+};
+
+// The Fluent thumb's rounded mask is a fast rounded corner, so that viz can
+// merge a surface showing a scrollbar into an embedding quad's pass that has
+// fast rounded corners of its own.
+TEST_F(PaintedScrollbarLayerImplFluentTest, ThumbMaskIsFastRoundedCorner) {
+  PaintedScrollbarLayerImpl* scrollbar_layer_impl = SetUpScrollbarLayerImpl(
+      ScrollbarOrientation::kVertical,
+      /*is_left_side_vertical_scrollbar=*/false, gfx::Rect(0, 0, 14, 100),
+      /*thumb_thickness=*/6, /*minimum_thumb_length=*/30);
+  CopyProperties(impl_->root_layer(), scrollbar_layer_impl);
+  impl_->CalcDrawProps(gfx::Size(500, 500));
+  impl_->AppendQuads(scrollbar_layer_impl);
+
+  ASSERT_FALSE(impl_->quad_list().empty());
+  const viz::DrawQuad* thumb_draw_quad = impl_->quad_list().ElementAt(0);
+  EXPECT_EQ(viz::DrawQuad::Material::kSolidColor, thumb_draw_quad->material);
+  EXPECT_TRUE(
+      thumb_draw_quad->shared_quad_state->mask_filter_info.HasRoundedCorners());
+  EXPECT_TRUE(thumb_draw_quad->shared_quad_state->is_fast_rounded_corner);
+}
