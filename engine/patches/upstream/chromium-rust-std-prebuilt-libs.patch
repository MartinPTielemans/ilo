From Chromium (https://chromium.googlesource.com/chromium/src, BSD-3-Clause, Copyright The Chromium
Authors), commit f3417da85a5f7a176e13ff9ae6d5d822e3f5faae, "[rust] Fix `is_component_build` vs
`rust_sysroot_absolute` interaction" (https://chromium-review.googlesource.com/c/chromium/src/+/8564239,
refs/heads/main@{#1718864}), which Chromium 157.0.8103.50 doesn't have yet. Its change, unchanged,
with one line of context, so that it applies to 156 and 157. ungoogled-chromium-windows 157's
windows-fix-building-without-crubit makes the same change, so on Windows the series finds it in the
tree and goes on. Drop it once every platform's Chromium has the commit.

Lets the dev (component) build link libraries whose only use of Rust's prebuilt std is a function
clang's runtime also has. The prebuilt rlibs were ldflags of an all_dependent_configs, so every
shared library linked them, first, even without Rust code: one that calls a runtime function std
keeps a weak copy of, as Objective-C's @available calls ___isPlatformVersionAtLeast, linked std for
it, and std needs the allocator only libraries with Rust code link. As libs of a source_set they
reach only the shared libraries that have Rust code, after their own objects.

--- a/build/rust/std/BUILD.gn
+++ b/build/rust/std/BUILD.gn
@@ -344,22 +344,15 @@
 
-    config("prebuilt_stdlib_libs") {
-      ldflags = []
-      lib_dir = rebase_path("$prebuilt_rustc_sysroot/$sysroot_lib_subdir",
-                            root_build_dir)
-
-      # We're unable to make these files regular gn dependencies because
-      # they're prebuilt. Instead, we'll pass them in the ldflags. This doesn't
-      # work for all types of build because ldflags propagate differently from
-      # actual dependencies and therefore can end up in different targets from
-      # the remap_alloc.cc above. For example, in a component build, we might
-      # apply the remap_alloc.cc file and these ldlags to shared object A,
-      # while shared object B (that depends upon A) might get only the ldflags
-      # but not remap_alloc.cc, and thus the build will fail. There is
-      # currently no known solution to this for the prebuilt stdlib - this
-      # problem does not apply with configurations where we build the stdlib
-      # ourselves, which is what we'll use in production.
+    # The prebuilt rlibs are not built by GN, so they are passed to the linker
+    # via `libs`.  `libs` set on a target (rather than in a config) propagate
+    # to dependents only until the nearest shared library or executable - the
+    # same way as GN dependencies on `//build/rust/allocator` and on other Rust
+    # libraries.  This ensures that in a component build the rlibs are linked
+    # only into the shared libraries that contain Rust code (and therefore also
+    # the allocator shims that the rlibs depend on).
+    source_set("prebuilt_stdlib_libs") {
+      libs = []
       foreach(lib, stdlib_files) {
-        this_file = "$lib_dir/lib$lib.rlib"
-        ldflags += [ this_file ]
+        libs += [ "$prebuilt_rustc_sysroot/$sysroot_lib_subdir/lib$lib.rlib" ]
       }
+      deps = [ ":prebuilt_rustc_copy_to_sysroot" ]
       visibility = [ ":*" ]
@@ -368,7 +361,4 @@
     group("std") {
-      all_dependent_configs = [
-        ":prebuilt_stdlib_libs",
-        ":stdlib_public_dependent_libs",
-      ]
-      deps = [ ":prebuilt_rustc_copy_to_sysroot" ]
+      all_dependent_configs = [ ":stdlib_public_dependent_libs" ]
+      deps = [ ":prebuilt_stdlib_libs" ]
     }
