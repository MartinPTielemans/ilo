+// browser_core: whether |view|'s page is a tile (content::SetPageTile), which takes no pointer,
+// cursor, tooltip or keyboard, and keeps the frame and screen it had.
+bool InPageTile(NSView* view) {
+  for (NSView* above = view.superview; above; above = above.superview) {
+    if (WebContentsViewCocoa* page =
+            base::apple::ObjCCast<WebContentsViewCocoa>(above)) {
+      return page.browserCoreTile;
+    }
+  }
+  return false;
+}
