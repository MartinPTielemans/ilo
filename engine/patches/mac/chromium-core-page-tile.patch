+// browser_core: lets the core show an agent's page live in a view of the app's, as a tile (#4115).
+
+#ifndef CONTENT_PUBLIC_BROWSER_PAGE_TILE_MAC_H_
+#define CONTENT_PUBLIC_BROWSER_PAGE_TILE_MAC_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class WebContents;
+
+// Whether |contents|' page is a tile: its views take no pointer, cursor, tooltip or drop, never
+// take the keyboard, and don't tell the page the frame or screen the tile moves them to, so it
+// keeps the size and screen it had. Set before the core moves the view into the tile, and cleared
+// after it moves it out.
+CONTENT_EXPORT void SetPageTile(WebContents* contents, bool tile);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_PAGE_TILE_MAC_H_
