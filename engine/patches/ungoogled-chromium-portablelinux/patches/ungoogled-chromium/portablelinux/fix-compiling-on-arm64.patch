+def GetHostSysrootPlatform():
+  assert sys.platform == 'linux', \
+    "This patch only applies to Linux, where platform.machine() is predictable"
+
+  arch = platform.machine()
+  return {
+    "aarch64": "arm64",
+    "aarch64_be": "arm64",
+    "armv7l": "arm",
+    "armv8b": "arm64",
+    "armv8l": "arm64",
+    "x86_64": "amd64",
+  }.get(arch, arch)
