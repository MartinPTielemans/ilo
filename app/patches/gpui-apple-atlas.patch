+/// Says on stderr, for ilo's checks, why a frame didn't reach the screen: at most one line in five
+/// seconds for each cause, with how many it left out, so a GPU or window server that stops taking
+/// a window's frames (#3270) shows in the log the checks keep, without a line for every frame.
+pub struct LostFrames(std::sync::Mutex<(Option<std::time::Instant>, u32)>);
+
+impl LostFrames {
+    pub const fn new() -> Self {
+        Self(std::sync::Mutex::new((None, 0)))
+    }
+
+    pub fn say(&self, why: std::fmt::Arguments) {
+        use std::io::Write as _;
+        let Ok(mut last) = self.0.lock() else {
+            return;
+        };
+        let now = std::time::Instant::now();
+        if last
+            .0
+            .is_some_and(|at| now.duration_since(at) < std::time::Duration::from_secs(5))
+        {
+            last.1 += 1;
+            return;
+        }
+        let left_out = mem::take(&mut last.1);
+        last.0 = Some(now);
+        drop(last);
+        // One write, so a line Chromium logs at the same time can't land inside it.
+        _ = std::io::stderr().write_all(
+            format!("browser: gpui frame lost: {why}, {left_out} more left out\n").as_bytes(),
+        );
+    }
+}
+
+static NO_DRAWABLE: LostFrames = LostFrames::new();
+static FAILED_COMMANDS: LostFrames = LostFrames::new();
+
