+
+/// Whether the overlays that ask blur what's behind them (`set_overlay_blur`): on X11, where KWin
+/// composites, each a window of its own over the embedder's, so the blur takes in its pages too.
+/// Other compositors blur by their own rules, if at all, and none at a window's asking. Under
+/// Wayland an overlay is a subsurface of the embedder's window, and a compositor blurs only what's
+/// under a window, never what its own surfaces draw.
+/// Read from a store GPUI sets once as it connects, since a view asks while it draws, when the
+/// connection can be borrowed for the event being handled.
+pub fn overlays_blur() -> bool {
+    OVERLAYS_BLUR.load(Ordering::Relaxed)
+}
+
+pub(crate) static OVERLAYS_BLUR: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn is_shown(view: usize) -> bool {
+    SHOWN.with_borrow(|all| all.iter().any(|shown| shown.view == view))
+}
+
+/// On X11, takes the overlay `view` off screen with the window it shows over, which the window
+/// manager hid, or says it's back (`away`). It says whether the overlay had the keys.
+#[cfg(feature = "x11")]
+pub(crate) fn set_away(view: usize, away: bool) -> bool {
+    SHOWN.with_borrow_mut(|all| {
+        all.iter_mut()
+            .find(|shown| shown.view == view)
+            .is_some_and(|shown| {
+                shown.away = away;
+                shown.keyboard && shown.ready
+            })
+    })
+}
+
+/// Whether the overlay `view` is off screen with the window it shows over (`set_away`).
+#[cfg(feature = "x11")]
+pub(crate) fn is_away(view: usize) -> bool {
+    SHOWN.with_borrow(|all| all.iter().any(|shown| shown.view == view && shown.away))
+}
+
+/// The overlay that shows with the keyboard, if one does.
+#[allow(dead_code)]
+pub(crate) fn keyboard_overlay() -> Option<usize> {
+    SHOWN.with_borrow(|all| {
+        all.iter()
+            .rev()
+            .find(|shown| shown.keyboard && shown.ready)
+            .map(|shown| shown.view)
+    })
+}
+
+/// The view of the overlay that shows with the keyboard, for a test driver: under Wayland the
+/// compositor gives the keys to the browser window, whose overlays it doesn't know of.
+pub fn shown_keyboard_overlay() -> Option<*mut c_void> {
+    keyboard_overlay().map(|view| view as *mut c_void)
+}
