+                true => {
+                    let (width, height) = (width.max(1.) as u32, height.max(1.) as u32);
+                    self.managed_place_hints(view, x as i32, y as i32, width, height)?;
+                    PLACED.with_borrow_mut(|all| {
+                        all.retain(|&(each, ..)| each != view);
+                        all.push((view, x as i32, y as i32, width, height));
+                    });
