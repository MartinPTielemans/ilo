 fn fp3232_to_f32(value: xinput::Fp3232) -> f32 {
     value.integral as f32 + value.frac as f32 / u32::MAX as f32
 }
 
+fn fp3232_to_f64(value: xinput::Fp3232) -> f64 {
+    f64::from(value.integral) + f64::from(value.frac) / (1u64 << 32) as f64
+}
