+/// How an embedder on Wayland shares its keyboard with GPUI's windows in its surfaces: the
+/// compositor gives it to the embedder's toplevel, and every key reaches both.
+#[derive(Clone, Copy)]
+pub struct EmbeddedKeyboard {
+    /// The user pressed in GPUI's window in the embedder's surface `parent`, which takes the
+    /// keyboard there, as a click in a window does.
+    pub pressed: fn(parent: *mut std::ffi::c_void),
+    /// The user pressed in the embedder's surface `parent` itself, outside GPUI's window, such as
+    /// in a page, which takes the keyboard from GPUI's window without its focus changing.
+    pub page_pressed: fn(parent: *mut std::ffi::c_void),
+    /// Whether the keys in the embedder's surface `parent` are GPUI's window's now.
+    pub is_ui: fn(parent: *mut std::ffi::c_void) -> bool,
+    /// A text field in the embedder's surface `parent` has the keys, its caret at `caret` in
+    /// logical pixels from the surface's top left, or none has. The compositor gives one client
+    /// one input method, so the embedder's composes for it, into [`compose_embedded`] and
+    /// [`commit_embedded`], while the keys are GPUI's.
+    pub text_input: fn(parent: *mut std::ffi::c_void, caret: Option<gpui::Bounds<gpui::Pixels>>),
+}
