diff --git a/crates/gpui_linux/src/linux/x11/drag.rs b/crates/gpui_linux/src/linux/x11/drag.rs
new file mode 100644
index 0000000000..704677746c
--- /dev/null
+++ b/crates/gpui_linux/src/linux/x11/drag.rs
@@ -0,0 +1,492 @@
+//! A file's drag out of GPUI's windows on X11, as XDND's source (freedesktop.org's XDND, version
+//! 5): the window the left button went down in owns `XdndSelection`, the pointer is grabbed until
+//! it's let go, and the top-level window under it that takes XDND hears where it is and, if it
+//! accepts the file there, gets it. GPUI is XDND's target in client.rs.
+
+use gpui_util::ResultExt as _;
+use x11rb::{
+    connection::Connection as _,
+    protocol::{
+        shape::{self, ConnectionExt as _},
+        xproto::{
+            self, AtomEnum, ClientMessageEvent, ConfigureWindowAux, ConnectionExt as _,
+            CreateWindowAux, EventMask, GrabMode, ImageFormat, PropMode, SelectionNotifyEvent,
+            SelectionRequestEvent, StackMode, WindowClass,
+        },
+    },
+    xcb_ffi::XCBConnection,
+};
+
+use super::{X11Client, XcbAtoms};
+
+pub(crate) struct FileDrag {
+    /// GPUI's window it started in, which owns `XdndSelection` and hears from the targets.
+    window: xproto::Window,
+    /// The type it carries, and what.
+    kind: xproto::Atom,
+    data: Vec<u8>,
+    /// Where the pointer last was on the root, for where it's let go.
+    last: (i16, i16),
+    /// Until it's let go.
+    held: bool,
+    /// The top-level window under the pointer that takes XDND, with its version.
+    target: Option<(xproto::Window, u32)>,
+    /// The target was told where the pointer is and hasn't answered, as XDND has the source wait
+    /// for before it says again.
+    asked: bool,
+    /// Where the pointer moved to on the root while the target hadn't answered, and when.
+    moved: Option<(i16, i16, u32)>,
+    accepted: bool,
+    /// Let go while the target hadn't answered, when.
+    released: Option<u32>,
+    /// The picture of what's dragged, an override-redirect window the pointer carries, and where
+    /// the pointer holds it, until it's let go.
+    icon: Option<DragIcon>,
+}
+
+struct DragIcon {
+    window: xproto::Window,
+    pixmap: xproto::Pixmap,
+    hold: (i16, i16),
+}
+
+impl X11Client {
+    /// Starts dragging `data`, as `mime`, from the window the left button went down in, which
+    /// it's held in.
+    pub(crate) fn start_drag(&self, mime: &str, data: Vec<u8>) -> bool {
+        let mut state = self.0.borrow_mut();
+        let Some(window) = state.pressed_window.filter(|_| state.file_drag.is_none()) else {
+            return false;
+        };
+        let xcb = state.xcb_connection.clone();
+        let kind = match mime {
+            "text/uri-list" => state.atoms.TextUriList,
+            _ => match xcb.intern_atom(false, mime.as_bytes()).ok().and_then(|c| c.reply().ok()) {
+                Some(reply) => reply.atom,
+                None => return false,
+            },
+        };
+        let root = xcb.setup().roots[state.x_root_index].root;
+        let owned = xcb.set_selection_owner(window, state.atoms.XdndSelection, x11rb::CURRENT_TIME);
+        if owned.log_err().is_none() {
+            return false;
+        }
+        // On the root, which a hold on the window the press went down in would lose as that window
+        // hides, as the downloads' window does when one of its files is dragged.
+        xcb.grab_pointer(
+            false,
+            root,
+            EventMask::POINTER_MOTION | EventMask::BUTTON_RELEASE,
+            GrabMode::ASYNC,
+            GrabMode::ASYNC,
+            x11rb::NONE,
+            x11rb::NONE,
+            x11rb::CURRENT_TIME,
+        )
+        .log_err();
+        xcb.flush().log_err();
+        state.file_drag = Some(FileDrag {
+            window,
+            kind,
+            data,
+            last: (0, 0),
+            held: true,
+            target: None,
+            asked: false,
+            moved: None,
+            accepted: false,
+            released: None,
+            icon: None,
+        });
+        true
+    }
+
+    /// Shows `rgba`, `width` by `height` top-down RGBA pixels, under the pointer of the drag
+    /// that's held, with the pointer at `hold` in it, as the picture of what's dragged.
+    pub(crate) fn set_drag_icon(
+        &self,
+        width: u16,
+        height: u16,
+        rgba: &[u8],
+        hold: (i16, i16),
+    ) -> bool {
+        let mut state = self.0.borrow_mut();
+        let state = &mut *state;
+        let xcb = &state.xcb_connection;
+        let Some(drag) = state.file_drag.as_mut().filter(|drag| drag.held) else {
+            return false;
+        };
+        let screen = &xcb.setup().roots[state.x_root_index];
+        let (root, depth, visual) = (screen.root, screen.root_depth, screen.root_visual);
+        if width == 0 || height == 0 || rgba.len() != usize::from(width) * usize::from(height) * 4
+        {
+            return false;
+        }
+        let made = || -> anyhow::Result<DragIcon> {
+            let pixmap = xcb.generate_id()?;
+            xcb.create_pixmap(depth, pixmap, root, width, height)?;
+            let gc = xcb.generate_id()?;
+            xcb.create_gc(gc, pixmap, &Default::default())?;
+            // The X server's pixels are BGRX, in bands that each fit in a request.
+            let bgrx: Vec<u8> = (rgba.chunks_exact(4))
+                .flat_map(|pixel| [pixel[2], pixel[1], pixel[0], 0xff])
+                .collect();
+            let row = usize::from(width) * 4;
+            let band = (60_000 / row).max(1);
+            for (index, rows) in bgrx.chunks(row * band).enumerate() {
+                let top = (index * band) as i16;
+                let rows_high = (rows.len() / row) as u16;
+                xcb.put_image(
+                    ImageFormat::Z_PIXMAP,
+                    pixmap,
+                    gc,
+                    width,
+                    rows_high,
+                    0,
+                    top,
+                    0,
+                    depth,
+                    rows,
+                )?;
+            }
+            xcb.free_gc(gc)?;
+            let window = xcb.generate_id()?;
+            xcb.create_window(
+                depth,
+                window,
+                root,
+                0,
+                0,
+                width,
+                height,
+                0,
+                WindowClass::INPUT_OUTPUT,
+                visual,
+                &CreateWindowAux::new()
+                    .override_redirect(1)
+                    .background_pixmap(pixmap),
+            )?;
+            // It takes no input, so the window under it is the one the pointer is over, for XDND
+            // as for the pointer.
+            xcb.shape_rectangles(
+                shape::SO::SET,
+                shape::SK::INPUT,
+                xproto::ClipOrdering::UNSORTED,
+                window,
+                0,
+                0,
+                &[],
+            )?;
+            Ok(DragIcon {
+                window,
+                pixmap,
+                hold,
+            })
+        };
+        let Some(icon) = made().log_err() else {
+            return false;
+        };
+        // Where the pointer is now, as it may not have moved since the drag started.
+        let (x, y) = match xcb.query_pointer(root).ok().and_then(|c| c.reply().ok()) {
+            Some(pointer) => (pointer.root_x, pointer.root_y),
+            None => drag.last,
+        };
+        place_icon(xcb, &icon, x, y);
+        xcb.map_window(icon.window).log_err();
+        if let Some(old) = drag.icon.replace(icon) {
+            remove_icon(xcb, old);
+        }
+        xcb.flush().log_err();
+        true
+    }
+
+    pub(crate) fn file_drag_held(&self) -> bool {
+        (self.0.borrow().file_drag.as_ref()).is_some_and(|drag| drag.held)
+    }
+
+    /// The pointer moved to (x, y) on the root at `time`.
+    pub(crate) fn file_drag_moved(&self, x: i16, y: i16, time: u32) {
+        let mut state = self.0.borrow_mut();
+        let state = &mut *state;
+        let xcb = &state.xcb_connection;
+        let atoms = &state.atoms;
+        let Some(drag) = state.file_drag.as_mut() else {
+            return;
+        };
+        let root = xcb.setup().roots[state.x_root_index].root;
+        drag.last = (x, y);
+        if let Some(icon) = &drag.icon {
+            place_icon(xcb, icon, x, y);
+        }
+        let target = xdnd_target(xcb, atoms, root, x, y);
+        if target.map(|(window, _)| window) != drag.target.map(|(window, _)| window) {
+            if let Some((window, _)) = drag.target.take() {
+                send(xcb, window, atoms.XdndLeave, [drag.window, 0, 0, 0, 0]);
+            }
+            (drag.asked, drag.accepted, drag.moved) = (false, false, None);
+            if let Some((window, version)) = target {
+                let version = version.min(5) << 24;
+                send(
+                    xcb,
+                    window,
+                    atoms.XdndEnter,
+                    [drag.window, version, drag.kind, 0, 0],
+                );
+                drag.target = target;
+            }
+        }
+        if drag.target.is_some() {
+            match drag.asked {
+                true => drag.moved = Some((x, y, time)),
+                false => ask(xcb, atoms, drag, x, y, time),
+            }
+        }
+        xcb.flush().log_err();
+    }
+
+    /// The left button was let go at `time`.
+    pub(crate) fn file_drag_released(&self, time: u32) {
+        let let_go = {
+            let mut state = self.0.borrow_mut();
+            let state = &mut *state;
+            let Some(drag) = state.file_drag.as_mut() else {
+                return;
+            };
+            drag.held = false;
+            if let Some(icon) = drag.icon.take() {
+                remove_icon(&state.xcb_connection, icon);
+            }
+            state
+                .xcb_connection
+                .ungrab_pointer(x11rb::CURRENT_TIME)
+                .log_err();
+            state.xcb_connection.flush().log_err();
+            match drag.asked {
+                // Once it answers.
+                true => {
+                    drag.released = Some(time);
+                    false
+                }
+                false => true,
+            }
+        };
+        if let_go {
+            self.file_drag_let_go(time);
+        }
+    }
+
+    /// Drops the file on the target if it accepted it where the pointer was let go, or else ends
+    /// the drag with nothing taking it.
+    fn file_drag_let_go(&self, time: u32) {
+        let at = self.drag_let_go_at();
+        {
+            let mut state = self.0.borrow_mut();
+            let state = &mut *state;
+            let (xcb, atoms) = (&state.xcb_connection, &state.atoms);
+            let Some(drag) = state.file_drag.as_mut() else {
+                return;
+            };
+            if let Some((window, _)) = drag.target {
+                // Until the target says it's finished with it.
+                if drag.accepted {
+                    send(xcb, window, atoms.XdndDrop, [drag.window, 0, time, 0, 0]);
+                    xcb.flush().log_err();
+                    return;
+                }
+                send(xcb, window, atoms.XdndLeave, [drag.window, 0, 0, 0, 0]);
+                xcb.flush().log_err();
+            }
+            state.file_drag = None;
+        }
+        crate::linux::drag_ended(crate::linux::DragEnd::LetGo(at));
+    }
+
+    /// Where the drag's pointer last was on the root, in the screen's logical pixels.
+    fn drag_let_go_at(&self) -> Option<(f32, f32)> {
+        let state = self.0.borrow();
+        let (x, y) = state.file_drag.as_ref()?.last;
+        let scale = state.scale_factor;
+        Some((f32::from(x) / scale, f32::from(y) / scale))
+    }
+
+    /// Escape was pressed while dragging: the target hears it left, and nothing takes it.
+    pub(crate) fn drag_cancelled(&self) {
+        {
+            let mut state = self.0.borrow_mut();
+            let state = &mut *state;
+            let (xcb, atoms) = (&state.xcb_connection, &state.atoms);
+            let Some(mut drag) = state.file_drag.take() else {
+                return;
+            };
+            if let Some((window, _)) = drag.target {
+                send(xcb, window, atoms.XdndLeave, [drag.window, 0, 0, 0, 0]);
+            }
+            if let Some(icon) = drag.icon.take() {
+                remove_icon(xcb, icon);
+            }
+            xcb.ungrab_pointer(x11rb::CURRENT_TIME).log_err();
+            xcb.flush().log_err();
+        }
+        crate::linux::drag_ended(crate::linux::DragEnd::Cancelled);
+    }
+
+    /// Handles `message` if it's the target's answer, XdndStatus or XdndFinished.
+    pub(crate) fn file_drag_message(&self, message: &ClientMessageEvent) -> bool {
+        let at = self.drag_let_go_at();
+        let (let_go, ended) = {
+            let mut state = self.0.borrow_mut();
+            let state = &mut *state;
+            let (xcb, atoms) = (&state.xcb_connection, &state.atoms);
+            let Some(drag) = state.file_drag.as_mut() else {
+                return false;
+            };
+            let [from, flags, ..] = message.data.as_data32();
+            // One from a target the pointer has left is for nothing.
+            let from_target = drag.target.is_some_and(|(window, _)| window == from);
+            if message.type_ == atoms.XdndStatus {
+                let mut let_go = None;
+                if from_target && drag.asked {
+                    drag.asked = false;
+                    drag.accepted = flags & 1 == 1;
+                    let_go = drag.released.take();
+                    if let_go.is_none()
+                        && let Some((x, y, time)) = drag.moved.take()
+                    {
+                        ask(xcb, atoms, drag, x, y, time);
+                        xcb.flush().log_err();
+                    }
+                }
+                (let_go, None)
+            } else if message.type_ == atoms.XdndFinished {
+                let mut ended = None;
+                if from_target && !drag.held {
+                    let version = drag.target.map_or(0, |(_, version)| version);
+                    state.file_drag = None;
+                    // Before version 5, a target that finished took it.
+                    ended = Some(version < 5 || flags & 1 == 1);
+                }
+                (None, ended)
+            } else {
+                return false;
+            }
+        };
+        if let Some(time) = let_go {
+            self.file_drag_let_go(time);
+        }
+        if let Some(taken) = ended {
+            crate::linux::drag_ended(match taken {
+                true => crate::linux::DragEnd::Taken,
+                false => crate::linux::DragEnd::LetGo(at),
+            });
+        }
+        true
+    }
+
+    /// Answers a target's request for the dragged file, as `text/uri-list`.
+    pub(crate) fn file_drag_selection(&self, request: &SelectionRequestEvent) {
+        let state = self.0.borrow();
+        let (xcb, atoms) = (&state.xcb_connection, &state.atoms);
+        let Some(drag) = state.file_drag.as_ref() else {
+            return;
+        };
+        if request.owner != drag.window || request.selection != atoms.XdndSelection {
+            return;
+        }
+        // A requestor of before ICCCM 2 names no property.
+        let property = match request.property {
+            x11rb::NONE => request.target,
+            property => property,
+        };
+        let given = request.target == drag.kind
+            && (xcb.change_property(
+                PropMode::REPLACE,
+                request.requestor,
+                property,
+                drag.kind,
+                8,
+                drag.data.len() as u32,
+                &drag.data,
+            ))
+            .log_err()
+            .is_some();
+        let answer = SelectionNotifyEvent {
+            response_type: xproto::SELECTION_NOTIFY_EVENT,
+            sequence: 0,
+            time: request.time,
+            requestor: request.requestor,
+            selection: request.selection,
+            target: request.target,
+            property: if given { property } else { x11rb::NONE },
+        };
+        xcb.send_event(false, request.requestor, EventMask::NO_EVENT, answer)
+            .log_err();
+        xcb.flush().log_err();
+    }
+}
+
+/// Tells the target the pointer is at (x, y) on the root, at `time`, and that the file would be
+/// copied there.
+fn ask(xcb: &XCBConnection, atoms: &XcbAtoms, drag: &mut FileDrag, x: i16, y: i16, time: u32) {
+    let Some((window, _)) = drag.target else {
+        return;
+    };
+    let at = (x as u16 as u32) << 16 | y as u16 as u32;
+    send(
+        xcb,
+        window,
+        atoms.XdndPosition,
+        [drag.window, 0, at, time, atoms.XdndActionCopy],
+    );
+    drag.asked = true;
+}
+
+/// The window at (x, y) on `root` that takes XDND, with its version: the first one down from the
+/// root that says so, a top-level window, inside any window manager's frame.
+fn xdnd_target(
+    xcb: &XCBConnection,
+    atoms: &XcbAtoms,
+    root: xproto::Window,
+    x: i16,
+    y: i16,
+) -> Option<(xproto::Window, u32)> {
+    let mut window = root;
+    loop {
+        window = xcb
+            .translate_coordinates(root, window, x, y)
+            .ok()?
+            .reply()
+            .ok()?
+            .child;
+        if window == x11rb::NONE {
+            return None;
+        }
+        let aware = (xcb.get_property(false, window, atoms.XdndAware, AtomEnum::ATOM, 0, 1))
+            .ok()?
+            .reply()
+            .ok()?;
+        if let Some(version) = aware.value32().and_then(|mut values| values.next()) {
+            return Some((window, version));
+        }
+    }
+}
+
+/// Puts `icon` with the pointer at (x, y) on the root where it holds it, over every other window.
+fn place_icon(xcb: &XCBConnection, icon: &DragIcon, x: i16, y: i16) {
+    let place = ConfigureWindowAux::new()
+        .x(i32::from(x) - i32::from(icon.hold.0))
+        .y(i32::from(y) - i32::from(icon.hold.1))
+        .stack_mode(StackMode::ABOVE);
+    xcb.configure_window(icon.window, &place).log_err();
+}
+
+fn remove_icon(xcb: &XCBConnection, icon: DragIcon) {
+    xcb.destroy_window(icon.window).log_err();
+    xcb.free_pixmap(icon.pixmap).log_err();
+    xcb.flush().log_err();
+}
+
+fn send(xcb: &XCBConnection, to: xproto::Window, type_: xproto::Atom, data: [u32; 5]) {
+    let message = ClientMessageEvent::new(32, to, type_, data);
+    xcb.send_event(false, to, EventMask::NO_EVENT, message)
+        .log_err();
+}
