+
+/// Whether an overlay's pixels blend with what's under it, as a fade needs: under Wayland, and on
+/// X11 with a compositor, which would otherwise draw them opaque.
+pub fn overlays_blend() -> bool {
+    super::platform::with_embedded_connection(|connection| match connection {
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => x11.0.borrow().compositor_present,
+        #[allow(unreachable_patterns)]
+        _ => true,
+    })
+    .unwrap_or(true)
