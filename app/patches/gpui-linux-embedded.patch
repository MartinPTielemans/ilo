+/// Whether `layout` types Latin letters, as US, AZERTY and Dvorak do and Hebrew, Arabic, Russian
+/// and Armenian don't: any of the keys in the letters' places types one.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn is_latin(keymap: &xkb::Keymap, layout: xkb::LayoutIndex) -> bool {
+    (24..=33).chain(38..=46).chain(52..=58).any(|code| {
+        keymap
+            .key_get_syms_by_level(Keycode::new(code), layout, 0)
+            .iter()
+            .any(|&sym| {
+                char::from_u32(xkb::keysym_to_utf32(sym)).is_some_and(|c| c.is_ascii_alphabetic())
+            })
+    })
