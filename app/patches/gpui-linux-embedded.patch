+/// Whether the window manager's active window, `_NET_ACTIVE_WINDOW` on `root`, is this process's:
+/// one of GPUI's `windows`, or one whose `_NET_WM_PID` is this process's, as an embedder's are.
+/// `None` without a window manager that names one.
+fn app_active(
+    xcb: &XCBConnection,
+    atoms: &XcbAtoms,
+    root: xproto::Window,
+    windows: &HashMap<xproto::Window, WindowRef>,
+) -> Option<bool> {
+    let active = xcb
+        .get_property(false, root, atoms._NET_ACTIVE_WINDOW, AtomEnum::WINDOW, 0, 1)
+        .ok()?
+        .reply()
+        .ok()?;
+    if active.type_ == u32::from(AtomEnum::NONE) {
+        return None;
+    }
+    let Some(window) = active.value32().and_then(|mut values| values.next()) else {
+        return Some(false);
+    };
+    if window == x11rb::NONE {
+        return Some(false);
+    }
+    if windows.contains_key(&window) {
+        return Some(true);
+    }
+    let pid = xcb
+        .get_property(false, window, atoms._NET_WM_PID, AtomEnum::CARDINAL, 0, 1)
+        .ok()
+        .and_then(|asked| asked.reply().ok())
+        .and_then(|reply| reply.value32().and_then(|mut values| values.next()));
+    Some(pid == Some(std::process::id()))
+}
