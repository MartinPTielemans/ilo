+thread_local! {
+    static EMBEDDED_CLIENT: RefCell<Option<std::rc::Weak<RefCell<WaylandClientState>>>> =
+        const { RefCell::new(None) };
+    static EMBEDDED_QUEUE: RefCell<Option<Box<dyn FnMut()>>> = const { RefCell::new(None) };
+    static DEFERRED_FRAMES: RefCell<Vec<(WaylandWindowStatePtr, Option<Instant>, gpui::FrameRequestSource)>> =
+        const { RefCell::new(Vec::new()) };
+    /// The caret the embedder was last told of for each of its surfaces GPUI is in.
+    static EMBEDDED_CARETS: RefCell<Vec<(usize, Option<Bounds<Pixels>>)>> =
+        const { RefCell::new(Vec::new()) };
+}
+
+/// GPUI's window in the embedder's surface `parent` whose text field the embedder's input method
+/// composes for, with where it is there: an overlay over it with the keys, else GPUI's window in
+/// it while the compositor gives the surface the keys. Whether the keys are GPUI's or a page's,
+/// the embedder knows.
+fn embedded_text_window(
+    parent: *mut std::ffi::c_void,
+) -> Option<(WaylandWindowStatePtr, Point<Pixels>)> {
+    let client = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade())?;
+    let windows: Vec<_> = client.borrow().windows.values().cloned().collect();
+    let mut found = None;
+    for window in windows {
+        let Some((surface, origin)) = window.embedder_surface() else {
+            continue;
+        };
+        if surface != parent || !window.is_active() {
+            continue;
+        }
+        if !window.is_embedded() {
+            return Some((window, origin));
+        }
+        found = Some((window, origin));
+    }
+    found
+}
+
+/// Tells the embedder where the caret of the text field that has the keys in its surface `parent`
+/// is, in logical pixels from the surface's top left, or that none has, when that changed: the
+/// compositor gives one client one input method, the embedder's, which composes for GPUI's fields
+/// too (`compose_embedded`, `commit_embedded`).
+pub(crate) fn refresh_embedded_text_input(parent: *mut std::ffi::c_void) {
+    let Some(keyboard) = crate::linux::platform::embedded_keyboard() else {
+        return;
+    };
+    let caret = embedded_text_window(parent).and_then(|(window, origin)| {
+        let caret = window.text_caret()?;
+        Some(caret.map(|caret| Bounds::new(caret.origin + origin, caret.size)))
+    });
+    let told = EMBEDDED_CARETS.with_borrow_mut(|all| {
+        let Some((_, last)) = all.iter_mut().find(|(each, _)| *each == parent as usize) else {
+            let caret = caret.flatten();
+            all.push((parent as usize, caret));
+            return Some(caret);
+        };
+        // A field that has the keys but no place yet keeps the caret it had: telling the embedder
+        // none would end its composition, committing a syllable the next key was to change.
+        let caret = match caret {
+            Some(None) => *last,
+            caret => caret.flatten(),
+        };
+        (*last != caret).then(|| {
+            *last = caret;
+            caret
+        })
+    });
+    if let Some(caret) = told {
+        (keyboard.text_input)(parent, caret);
+    }
+}
+
+/// The embedder's input method composes `text` in the text field that has the keys in its surface
+/// `parent`, or stops composing with no text.
+pub fn compose_embedded(parent: *mut std::ffi::c_void, text: &str) {
+    if let Some((window, _)) = embedded_text_window(parent) {
+        window.handle_ime(if text.is_empty() {
+            ImeInput::DeleteText
+        } else {
+            ImeInput::SetMarkedText(text.to_owned())
+        });
+    }
+}
+
+/// The embedder's input method commits `text` in the text field that has the keys in its surface
+/// `parent`, in place of what it composed.
+pub fn commit_embedded(parent: *mut std::ffi::c_void, text: &str) {
+    if let Some((window, _)) = embedded_text_window(parent) {
+        window.handle_ime(ImeInput::InsertText(text.to_owned()));
+    }
+}
+
+/// GPUI's window a test driver's input method composes in, by the surface it shows in: the
+/// embedder's, as for its input method, or a window's own, such as Settings'.
+fn drive_text_window(surface: *mut std::ffi::c_void) -> Option<WaylandWindowStatePtr> {
+    if let Some((window, _)) = embedded_text_window(surface) {
+        return Some(window);
+    }
+    let client = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade())?;
+    let windows: Vec<_> = client.borrow().windows.values().cloned().collect();
+    windows.into_iter().find(|window| {
+        let own = window.surface().id().as_ptr().cast::<std::ffi::c_void>();
+        window.embedder_surface().is_none() && own == surface && window.is_active()
+    })
+}
+
+/// For a test driver, as an input method, as X11's `drive_compose`: the text field with the keys
+/// in `surface` (drive_text_window) composes `text` with `selected` selected in it, or stops
+/// composing with `text` empty. Returns false unless one there takes text.
+pub fn drive_compose_in(
+    surface: *mut std::ffi::c_void,
+    text: &str,
+    selected: Option<std::ops::Range<usize>>,
+) -> bool {
+    let Some(window) = drive_text_window(surface) else {
+        return false;
+    };
+    window
+        .with_input_handler(|handler| match text.is_empty() {
+            true => {
+                if let Some(marked) = handler.marked_text_range() {
+                    handler.replace_text_in_range(Some(marked), "");
+                }
+            }
+            false => handler.replace_and_mark_text_in_range(None, text, selected),
+        })
+        .is_some()
+}
+
+/// As `drive_compose_in`: commits `text` in place of what was composed.
+pub fn drive_commit_in(surface: *mut std::ffi::c_void, text: &str) -> bool {
+    drive_text_window(surface)
+        .and_then(|window| {
+            window.with_input_handler(|handler| handler.replace_text_in_range(None, text))
+        })
+        .is_some()
+}
+
+/// What the text field with the keys in `surface` (drive_text_window) has marked, in UTF-16.
+pub fn marked_range_in(surface: *mut std::ffi::c_void) -> Option<std::ops::Range<usize>> {
+    let window = drive_text_window(surface)?;
+    window.with_input_handler(|handler| handler.marked_text_range()).flatten()
+}
+
+/// Whether `window`'s frame waits for the embedder to have read its display: Vulkan's present
+/// can read it too, which waits forever for a read the embedder has prepared and not finished.
+pub(crate) fn defer_frame(
+    window: &WaylandWindowStatePtr,
+    signal_at: Option<Instant>,
+    source: gpui::FrameRequestSource,
+) -> bool {
+    if crate::linux::platform::embedder_has_read()
+        || EMBEDDED_CLIENT.with_borrow(|client| client.is_none())
+    {
+        return false;
+    }
+    let first = DEFERRED_FRAMES.with_borrow_mut(|frames| {
+        let first = frames.is_empty();
+        if !frames.iter().any(|(each, ..)| each.ptr_eq(window)) {
+            frames.push((window.clone(), signal_at, source));
+        }
+        first
+    });
+    if first {
+        wake_after_read();
+    }
+    true
+}
+
+/// Draws the frames that waited for the embedder's read (`defer_frame`).
+pub(crate) fn run_deferred_frames() {
+    for (window, signal_at, source) in DEFERRED_FRAMES.take() {
+        window.deferred_frame_fired(signal_at, source);
+    }
+}
+
+fn refresh_embedded_text_input_of(window: &WaylandWindowStatePtr) {
+    if let Some((parent, _)) = window.embedder_surface() {
+        refresh_embedded_text_input(parent);
+    }
+}
+
+fn embedded_windows() -> Vec<WaylandWindowStatePtr> {
+    let Some(client) = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade()) else {
+        return Vec::new();
+    };
+    let client = client.borrow();
+    client
+        .windows
+        .values()
+        .filter(|window| window.is_embedded())
+        .cloned()
+        .collect()
+}
+
+/// Dispatches GPUI's events the embedder's reads queued, then sends what GPUI asked of the
+/// embedder's display: its own loop flushes before it sleeps, which an embedder's doesn't do for
+/// it, so a frame's commit would wait for the embedder's next request.
+pub(crate) fn dispatch_embedded_queue() {
+    // A callback that runs a nested loop of the embedder's doesn't dispatch the queue again.
+    EMBEDDED_QUEUE.with(|queue| {
+        if let Ok(mut queue) = queue.try_borrow_mut()
+            && let Some(dispatch) = queue.as_mut()
+        {
+            dispatch();
+        }
+    });
+    if let Some(window) = embedded_windows().first()
+        && let Some(backend) = window.surface().backend().upgrade()
+    {
+        backend.flush().ok();
+    }
+}
+
+/// Sizes the window GPUI opened in the embedder's `parent` surface, in logical pixels, as the
+/// embedder's layout changes: no compositor configures a subsurface.
+pub fn resize_embedded(parent: *mut std::ffi::c_void, width: f32, height: f32) {
+    for window in embedded_windows() {
+        if window.embedded_parent() == Some(parent) {
+            window.configure_embedded(size(px(width), px(height)));
+        }
+    }
+}
+
+fn embedded_window_with_parent(parent: *mut std::ffi::c_void) -> Option<WaylandWindowStatePtr> {
+    embedded_windows()
+        .into_iter()
+        .find(|window| window.embedded_parent() == Some(parent))
+}
+
+/// The size of GPUI's window in the embedder's `parent` surface, or of GPUI's own window of that
+/// surface, one the embedder showed (`show_window`).
+pub(crate) fn embedded_size(parent: *mut std::ffi::c_void) -> Option<Size<Pixels>> {
+    match embedded_window_with_parent(parent) {
+        Some(window) => Some(window.bounds_size()),
+        None => Some(overlay_window(parent)?.bounds_size()),
+    }
+}
+
+/// The size of the overlay window of the `view` surface.
+pub(crate) fn overlay_size(view: *mut std::ffi::c_void) -> Option<Size<Pixels>> {
+    Some(overlay_window(view)?.bounds_size())
+}
+
+/// The scale of GPUI's window in the embedder's `parent` surface, as `embedded_size` finds it.
+pub(crate) fn embedded_scale(parent: *mut std::ffi::c_void) -> Option<f32> {
+    match embedded_window_with_parent(parent) {
+        Some(window) => Some(window.scale()),
+        None => Some(overlay_window(parent)?.scale()),
+    }
+}
+
+/// The scale the overlay window of the `view` surface drew its first frame at since it showed.
+pub(crate) fn overlay_first_frame_scale(view: *mut std::ffi::c_void) -> Option<f32> {
+    overlay_window(view)?.first_frame_scale()
+}
