+/// The modifiers a sent core event's state holds, as XInput 2 gives them.
+fn sent_modifiers(state: xproto::KeyButMask) -> xinput::ModifierInfo {
+    xinput::ModifierInfo {
+        effective: u32::from(u16::from(state) & 0xff),
+        ..Default::default()
+    }
+}
+
+/// The buttons a sent core event's state holds down, as XInput 2's mask has them: bit n for
+/// button n, where the core state's Button1 is bit 8.
+fn sent_buttons(state: xproto::KeyButMask) -> u32 {
+    u32::from((u16::from(state) >> 8) & 0x1f) << 1
+}
