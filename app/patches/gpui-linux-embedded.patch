+/// Lets an embedder that runs the thread's loop, such as a browser engine, run GPUI:
+/// `Application::run_embedded` returns once GPUI has launched, rather than running a loop of its
+/// own, and the embedder calls [`dispatch_embedded`] whenever [`embedded_fd`] is readable. Call it
+/// before starting, on the thread GPUI runs on.
+pub fn embed() {
+    EMBEDDED.set(true);
+}
+
+/// As [`embed`], with GPUI on the embedder's Wayland display, a `wl_display*` from the same
+/// libwayland GPUI loads, rather than a connection of its own. Only the embedder reads it, so it
+/// also calls [`dispatch_embedded`] after each time it dispatches the display. GPUI's windows there
+/// take the keys only while `keyboard` says they're theirs.
+pub fn embed_wayland(display: *mut std::ffi::c_void, keyboard: EmbeddedKeyboard) {
+    EMBEDDED.set(true);
+    EMBEDDED_WAYLAND_DISPLAY.set(display);
+    EMBEDDED_KEYBOARD.set(Some(keyboard));
+}
+
+/// As [`embed`], with GPUI's X11 windows at the embedder's scale, in pixels a point, rather than
+/// the one GPUI finds (Xft.dpi): the embedder lays its content out around GPUI's in its points.
+/// `pressed` hears a click in a GPUI window the embedder hosts, its X window as a pointer, before
+/// GPUI handles it: the click takes the keyboard there, as [`EmbeddedKeyboard::pressed`] says on
+/// Wayland. GPUI moving the input focus into it says nothing when it already had it.
+pub fn embed_x11(scale: f32, pressed: fn(window: *mut std::ffi::c_void)) {
+    EMBEDDED.set(true);
+    EMBEDDER_X11_SCALE.set(Some(scale).filter(|scale| scale.is_normal() && *scale > 0.));
+    EMBEDDER_X11_PRESSED.set(Some(pressed));
+}
