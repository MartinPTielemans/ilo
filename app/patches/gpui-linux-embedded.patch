+/// for workspaces, and X11 sends none to GPUI's windows.
+pub fn watch_embedder_swipes(swiped: fn(parent: *mut std::ffi::c_void, x: f32, y: f32, back: bool)) {
+    EMBEDDER_SWIPED.set(Some(swiped));
+}
