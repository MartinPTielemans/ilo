+    /// `style`'s cursor over `window`: the picture the overlay shows in its place
+    /// (`set_overlay_cursor`), else the cursor theme's.
+    fn cursor_over(
+        &mut self,
+        window: xproto::Window,
+        style: CursorStyle,
+    ) -> Option<xproto::Cursor> {
+        // Those no overlay shows any more go.
+        let xcb = &self.xcb_connection;
+        self.picture_cursors.retain(|(picture, cursor)| {
+            let kept = Rc::strong_count(picture) > 1;
+            if !kept {
+                xcb.free_cursor(*cursor).log_err();
+            }
+            kept
+        });
+        let Some(picture) = crate::linux::overlay::overlay_cursor(window as usize, style) else {
+            return self.get_cursor_icon(style);
+        };
+        if let Some((_, cursor)) =
+            (self.picture_cursors.iter()).find(|(made, _)| Rc::ptr_eq(made, &picture))
+        {
+            return Some(*cursor);
+        }
+        match self.picture_cursor(&picture) {
+            Ok(cursor) => {
+                self.picture_cursors.push((picture, cursor));
+                Some(cursor)
+            }
+            Err(error) => {
+                log::warn!("X11: no cursor of the overlay's picture, so its style's: {error}");
+                self.get_cursor_icon(style)
+            }
+        }
+    }
+
+    /// An ARGB cursor of `picture`, through the Render extension, at its own size.
+    fn picture_cursor(
+        &self,
+        picture: &crate::linux::CursorPicture,
+    ) -> anyhow::Result<xproto::Cursor> {
+        use render::ConnectionExt as _;
+        let xcb = &self.xcb_connection;
+        let (width, height) = (
+            u16::try_from(picture.width)?,
+            u16::try_from(picture.height)?,
+        );
+        anyhow::ensure!(
+            picture.rgba.len() == usize::from(width) * usize::from(height) * 4,
+            "a picture of {} bytes isn't {width} by {height}",
+            picture.rgba.len()
+        );
+        let formats = xcb.render_query_pict_formats()?.reply()?;
+        let format = (formats.formats.iter())
+            .find(|format| {
+                let direct = &format.direct;
+                format.type_ == render::PictType::DIRECT
+                    && format.depth == 32
+                    && (direct.alpha_shift, direct.red_shift) == (24, 16)
+                    && (direct.green_shift, direct.blue_shift) == (8, 0)
+                    && direct.alpha_mask == 0xff
+            })
+            .context("no ARGB32 picture format")?
+            .id;
+        let root = xcb.setup().roots[self.x_root_index].root;
+        let pixmap = xcb.generate_id()?;
+        xcb.create_pixmap(32, pixmap, root, width, height)?;
+        let gc = xcb.generate_id()?;
+        xcb.create_gc(gc, pixmap, &Default::default())?;
+        // ARGB32's pixels are premultiplied, BGRA in memory.
+        let bgra: Vec<u8> = (picture.rgba.chunks_exact(4))
+            .flat_map(|pixel| {
+                let alpha = u16::from(pixel[3]);
+                let times = |channel: u8| ((u16::from(channel) * alpha + 127) / 255) as u8;
+                [times(pixel[2]), times(pixel[1]), times(pixel[0]), pixel[3]]
+            })
+            .collect();
+        xcb.put_image(
+            xproto::ImageFormat::Z_PIXMAP,
+            pixmap,
+            gc,
+            width,
+            height,
+            0,
+            0,
+            0,
+            32,
+            &bgra,
+        )?;
+        let source = xcb.generate_id()?;
+        xcb.render_create_picture(source, pixmap, format, &Default::default())?;
+        let cursor = xcb.generate_id()?;
+        let hot = |at: u32, most: u16| at.min(u32::from(most)) as u16;
+        xcb.render_create_cursor(
+            cursor,
+            source,
+            hot(picture.hot.0, width),
+            hot(picture.hot.1, height),
+        )?;
+        xcb.render_free_picture(source)?;
+        xcb.free_gc(gc)?;
+        xcb.free_pixmap(pixmap)?;
+        Ok(cursor)
+    }
