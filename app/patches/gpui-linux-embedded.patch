+        self.blur_under(window, &rows, false)?;
+        Ok(())
+    }
+
+    /// A ConfigureNotify of the managed overlay `window`, mapped and not yet seen: if the manager
+    /// put it in place, as one may without the answer `managed_overlay_answered` waits for, it shows.
+    fn managed_overlay_moved(&self, window: xproto::Window) -> anyhow::Result<()> {
+        let waits = UNPLACED.with_borrow(|all| all.iter().any(|(each, _)| *each == window))
+            && !CHECK_ON_MAP.with_borrow(|all| all.contains(&window))
+            && !RELEASING.with_borrow(|all| all.iter().any(|&(each, ..)| each == window));
+        let Some((_, x, y, width, height)) = waits
+            .then(|| PLACED.with_borrow(|all| all.iter().copied().find(|&(each, ..)| each == window)))
+            .flatten()
+        else {
+            return Ok(());
+        };
+        let xcb = &self.xcb_connection;
+        let root = xcb.setup().roots[self.x_root_index].root;
+        let at = xcb.translate_coordinates(window, root, 0, 0)?.reply()?;
+        let size = xcb.get_geometry(window)?.reply()?;
+        if (i32::from(at.dst_x) - x).abs() <= 1
+            && (i32::from(at.dst_y) - y).abs() <= 1
+            && u32::from(size.width) == width
+            && u32::from(size.height) == height
+        {
+            self.managed_overlay_seen(window)?;
+            xcb.flush()?;
+        }
+        Ok(())
+    }
+
+    /// Has KWin blur under the overlay `view` in its shape, or not, as `set_overlay_blur` says.
+    pub(crate) fn overlay_blur(&self, view: xproto::Window, panel: bool) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let shape = xcb.shape_get_rectangles(view, shape::SK::BOUNDING)?.reply()?;
+        self.blur_under(view, &shape.rectangles, panel)?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// KWin's blur region, `rows` of the window's own pixels as x, y, width and height each, on the
+    /// overlay `view` that blurs where a compositor blends it; else none.
+    fn blur_under(
+        &self,
+        view: xproto::Window,
+        rows: &[xproto::Rectangle],
+        panel: bool,
+    ) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let blur = self.atoms._KDE_NET_WM_BLUR_BEHIND_REGION;
+        if !(self.compositor_blurs && !panel && crate::linux::overlay::blurs(view as usize)) {
+            xcb.delete_property(view, blur)?;
+            return Ok(());
+        }
+        let region: Vec<u32> = (rows.iter())
+            .flat_map(|row| {
+                let (x, y) = (row.x.max(0) as u32, row.y.max(0) as u32);
+                [x, y, u32::from(row.width), u32::from(row.height)]
+            })
+            .collect();
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            blur,
+            xproto::AtomEnum::CARDINAL,
+            &region,
+        )?;
+        Ok(())
+    }
+
+    /// Stacks the overlay `under` directly under the overlay `over`, both over the same window.
+    pub(crate) fn place_overlay_under(
+        &self,
+        under: xproto::Window,
+        over: xproto::Window,
+    ) -> anyhow::Result<()> {
+        let place = (xproto::ConfigureWindowAux::new())
+            .sibling(over)
+            .stack_mode(xproto::StackMode::BELOW);
+        self.xcb_connection.configure_window(under, &place)?;
+        self.xcb_connection.flush()?;
+        Ok(())
+    }
+
+    /// Has the overlay `view`'s window say it's a menu (`set_overlay_menu`).
+    pub(crate) fn overlay_is_menu(&self, view: xproto::Window) -> anyhow::Result<()> {
+        let menu = self.atoms._NET_WM_WINDOW_TYPE_POPUP_MENU;
+        let (xcb, kind) = (&self.xcb_connection, self.atoms._NET_WM_WINDOW_TYPE);
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            kind,
+            xproto::AtomEnum::ATOM,
+            &[menu],
+        )?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// Makes the overlay `view` take the pointer only in `areas`, in logical pixels from its top
+    /// left, and let it through elsewhere, or take it all over its shape.
+    pub(crate) fn overlay_pointer(
+        &self,
+        view: xproto::Window,
+        areas: Option<&[Bounds<Pixels>]>,
+    ) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        match areas {
+            Some(areas) => {
+                let scale = self.scale_factor;
+                let rectangles: Vec<_> = (areas.iter())
+                    .map(|area| {
+                        let at = |pixels: Pixels| (f32::from(pixels) * scale).round();
+                        xproto::Rectangle {
+                            x: at(area.origin.x) as i16,
+                            y: at(area.origin.y) as i16,
+                            width: at(area.size.width) as u16,
+                            height: at(area.size.height) as u16,
+                        }
+                    })
+                    .collect();
+                xcb.shape_rectangles(
+                    shape::SO::SET,
+                    shape::SK::INPUT,
+                    xproto::ClipOrdering::UNSORTED,
+                    view,
+                    0,
+                    0,
+                    &rectangles,
+                )?;
+            }
+            None => {
+                xcb.shape_mask(shape::SO::SET, shape::SK::INPUT, view, 0, 0, x11rb::NONE)?;
+            }
+        }
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// Asks for the pointer's moves over the embedder's top-level that GPUI's `window` is in, beside
+    /// the embedder's own ask, to tell them from `window`'s top left, or stops asking.
+    pub(crate) fn watch_motion(&self, window: xproto::Window, watch: bool) -> anyhow::Result<()> {
+        let top = self.top_level(window)?;
+        MOTION_OVER.set(None);
+        if watch {
+            let at = self.xcb_connection.translate_coordinates(window, top, 0, 0)?.reply()?;
+            MOTION_OVER.set(Some((top, window, at.dst_x, at.dst_y)));
+        }
+        let window = top;
+        let mask = match watch {
+            true => xinput::XIEventMask::MOTION,
+            false => xinput::XIEventMask::from(0u32),
+        };
+        let masks = [xinput::EventMask {
+            deviceid: super::XINPUT_ALL_DEVICE_GROUPS,
+            mask: vec![mask],
+        }];
+        self.xcb_connection.xinput_xi_select_events(window, &masks)?;
+        self.xcb_connection.flush()?;
+        Ok(())
+    }
+
+    /// Gives the overlay `view` that shows the input focus, and returns the window that had it.
+    /// With `within`, the window it shows over, only if that one's top-level or an overlay has it,
+    /// not another app or another of the embedder's windows, and otherwise returns none.
+    pub(crate) fn overlay_takes_focus(
+        &self,
+        view: xproto::Window,
+        within: Option<xproto::Window>,
+    ) -> anyhow::Result<xproto::Window> {
+        let xcb = &self.xcb_connection;
+        let from = xcb.get_input_focus()?.reply()?.focus;
+        if let Some(within) = within
+            && !self.has_focus(from, within)?
+        {
+            // A managed one takes them once the window manager gives them to its top-level again,
+            // as after another desktop or app: the manager never gives them to the overlay itself.
+            if crate::linux::overlay::is_managed(view as usize) {
+                let top = self.top_level(within)?;
+                AWAY.with_borrow_mut(|all| {
+                    all.retain(|each| each.view != view);
+                    all.push(Away {
+                        view,
+                        top,
+                        keyboard: true,
+                        back: true,
+                    });
+                });
+                self.watch_top(top)?;
+            }
+            return Ok(x11rb::NONE);
+        }
+        // A window manager maps a managed one once it has taken it, until when it can't have the
+        // focus.
+        if crate::linux::overlay::is_managed(view as usize)
+            && xcb.get_window_attributes(view)?.reply()?.map_state != xproto::MapState::VIEWABLE
+        {
+            FOCUS_ON_MAP.with_borrow_mut(|all| {
+                if !all.contains(&view) {
+                    all.push(view);
+                }
+            });
+            return Ok(from);
+        }
+        xcb.set_input_focus(xproto::InputFocus::PARENT, view, x11rb::CURRENT_TIME)?;
+        xcb.flush()?;
+        Ok(from)
+    }
+
+    /// Has the window manager take the overlay `view` over `parent`'s window: no frame, transient
+    /// for the browser's window, which a manager keeps it over and with, a dialog, which a tiling
+    /// one floats and KWin doesn't hide while its app is inactive as it does a utility, but not
+    /// modal, out of the taskbar, pager and switcher, never given the keyboard by the manager.
+    fn manage_overlay(&self, view: xproto::Window, parent: xproto::Window) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let atom = |name: &[u8]| -> anyhow::Result<xproto::Atom> {
+            Ok(xcb.intern_atom(false, name)?.reply()?.atom)
+        };
+        let root = xcb.setup().roots[self.x_root_index].root;
+        // The browser's window, the one the manager holds: the first with WM_STATE from `parent`
+        // up, as KWin has a wrapper between its frame and the window.
+        let wm_state = atom(b"WM_STATE")?;
+        let mut client = parent;
+        loop {
+            let state = xcb.get_property(false, client, wm_state, AtomEnum::ANY, 0, 1)?.reply()?;
+            let up = xcb.query_tree(client)?.reply()?.parent;
+            if state.type_ != x11rb::NONE || up == root || up == x11rb::NONE {
+                break;
+            }
+            client = up;
+        }
+        CLIENTS.with_borrow_mut(|all| {
+            all.retain(|&(each, _)| each != view);
+            all.push((view, client));
+        });
+        // On the browser's desktop from its first map, and on whichever it goes to after.
+        let desktop = (xcb.get_property(
+            false,
+            client,
+            self.atoms._NET_WM_DESKTOP,
+            AtomEnum::CARDINAL,
+            0,
+            1,
+        )?)
+        .reply()?;
+        match desktop.value32().and_then(|mut each| each.next()) {
+            Some(desktop) => xcb.change_property32(
+                xproto::PropMode::REPLACE,
+                view,
+                self.atoms._NET_WM_DESKTOP,
+                AtomEnum::CARDINAL,
+                &[desktop],
+            )?,
+            None => xcb.delete_property(view, self.atoms._NET_WM_DESKTOP)?,
+        };
+        match self.top_level(client)? == client {
+            true => self.watch_top(client)?,
+            false => {
+                xcb.change_window_attributes(
+                    client,
+                    &xproto::ChangeWindowAttributesAux::new()
+                        .event_mask(xproto::EventMask::PROPERTY_CHANGE),
+                )?;
+            }
+        }
+        xcb.change_window_attributes(
+            view,
+            &xproto::ChangeWindowAttributesAux::new().override_redirect(0),
+        )?;
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            self.atoms.WM_TRANSIENT_FOR,
+            AtomEnum::WINDOW,
+            &[client],
+        )?;
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            self.atoms._NET_WM_WINDOW_TYPE,
+            AtomEnum::ATOM,
+            &[atom(b"_NET_WM_WINDOW_TYPE_DIALOG")?],
+        )?;
+        // Decorations named, and none.
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            self.atoms._MOTIF_WM_HINTS,
+            self.atoms._MOTIF_WM_HINTS,
+            &[1 << 1, 0, 0, 0, 0],
+        )?;
+        let states = [
+            atom(b"_NET_WM_STATE_SKIP_TASKBAR")?,
+            atom(b"_NET_WM_STATE_SKIP_PAGER")?,
+            atom(b"_KDE_NET_WM_STATE_SKIP_SWITCHER")?,
+        ];
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            self.atoms._NET_WM_STATE,
+            AtomEnum::ATOM,
+            &states,
+        )?;
+        // WM_HINTS with the input hint, and no input: GPUI gives it the keyboard itself.
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            AtomEnum::WM_HINTS,
+            AtomEnum::WM_HINTS,
+            &[1, 0, 0, 0, 0, 0, 0, 0, 0],
+        )?;
+        // It moves as the UI draws it, with no open or close animation of KWin's.
+        let skip = atom(b"_KDE_NET_WM_SKIP_CLOSE_ANIMATION")?;
+        xcb.change_property32(xproto::PropMode::REPLACE, view, skip, AtomEnum::CARDINAL, &[1])?;
+        Ok(())
+    }
+
+    /// WM_NORMAL_HINTS for the managed overlay `view` at `x`, `y`, `w` by `h` across the root: a
+    /// place and size the user chose, which a manager keeps rather than placing it, and its size as
+    /// the least and most, which a tiling manager floats.
+    fn managed_place_hints(
+        &self,
+        view: xproto::Window,
+        x: i32,
+        y: i32,
+        w: u32,
+        h: u32,
+    ) -> anyhow::Result<()> {
+        // USPosition, USSize, PPosition, PSize, PMinSize, PMaxSize.
+        let mut hints = [0u32; 18];
+        hints[..9].copy_from_slice(&[1 | 2 | 4 | 8 | 16 | 32, x as u32, y as u32, w, h, w, h, w, h]);
+        self.xcb_connection.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            AtomEnum::WM_NORMAL_HINTS,
+            AtomEnum::WM_SIZE_HINTS,
+            &hints,
+        )?;
+        Ok(())
+    }
+
+    /// Moves the managed overlay `view` to `x`, `y` across the root, and sizes it, as a tool, which
+    /// the manager does as asked, where KWin keeps a client's own move inside the screen's work
+    /// area, so a transient as large as the browser window wouldn't follow it partly off screen.
+    fn managed_move(
+        &self,
+        view: xproto::Window,
+        x: i32,
+        y: i32,
+        size: Option<(u32, u32)>,
+    ) -> anyhow::Result<Option<u64>> {
+        let xcb = &self.xcb_connection;
+        let root = xcb.setup().roots[self.x_root_index].root;
+        let supported = match MOVERESIZE.get() {
+            Some(supported) => supported,
+            None => {
+                let atoms = xcb.get_property(
+                    false,
+                    root,
+                    self.atoms._NET_SUPPORTED,
+                    AtomEnum::ATOM,
+                    0,
+                    1024,
+                )?;
+                let supported = (atoms.reply()?.value32().into_iter().flatten())
+                    .any(|each| each == self.atoms._NET_MOVERESIZE_WINDOW);
+                MOVERESIZE.set(Some(supported));
+                supported
+            }
+        };
+        if !supported {
+            return Ok(None);
+        }
+        // Static gravity, the window's own place; x and y, and the size if given; from a tool.
+        let flags = 10 | 1 << 8 | 1 << 9 | u32::from(size.is_some()) * (1 << 10 | 1 << 11) | 2 << 12;
+        let (width, height) = size.unwrap_or_default();
+        let data = [flags, x as u32, y as u32, width, height];
+        let message = xproto::ClientMessageEvent::new(
+            32,
+            view,
+            self.atoms._NET_MOVERESIZE_WINDOW,
+            data,
+        );
+        let sent = xcb.send_event(
+            false,
+            root,
+            xproto::EventMask::SUBSTRUCTURE_REDIRECT | xproto::EventMask::SUBSTRUCTURE_NOTIFY,
+            message,
+        )?;
+        Ok(Some(sent.sequence_number()))
+    }
+
+    /// The manager answered the managed overlay `window` that asked again for its place: it keeps
+    /// it there, or it shows unmanaged there (`managed_overlay_refused`).
+    fn managed_overlay_answered(&self, window: xproto::Window) -> anyhow::Result<()> {
+        ASKED_AGAIN.with_borrow_mut(|all| all.retain(|&(each, _)| each != window));
+        let Some((_, x, y, width, height)) =
+            PLACED.with_borrow(|all| all.iter().copied().find(|&(each, ..)| each == window))
+        else {
+            return Ok(());
+        };
+        let xcb = &self.xcb_connection;
+        let root = xcb.setup().roots[self.x_root_index].root;
+        let at = xcb.translate_coordinates(window, root, 0, 0)?.reply()?;
+        let size = xcb.get_geometry(window)?.reply()?;
+        let kept = (i32::from(at.dst_x) - x).abs() <= 1
+            && (i32::from(at.dst_y) - y).abs() <= 1
+            && u32::from(size.width) == width
+            && u32::from(size.height) == height;
+        if kept {
+            eprintln!("browser: overlay {window:#x}: the window manager put it in place");
+            self.managed_overlay_seen(window)?;
+            xcb.flush()?;
+            return Ok(());
+        }
+        eprintln!(
+            "browser: overlay {window:#x}: the window manager put it at {},{} {}x{} for {x},{y} \
+             {width}x{height}, so it shows unmanaged",
+            at.dst_x, at.dst_y, size.width, size.height,
+        );
+        self.managed_overlay_refused(window, x, y, width, height)?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// The managed overlay `window` the manager won't keep at `x`, `y` and its size, as a tiling
+    /// one that frames or tiles a dialog doesn't: it's unmapped, and shows there unmanaged once the
+    /// manager lets go of it, which it does after the unmap by putting it back on the root and
+    /// setting its WM_STATE to Withdrawn (ICCCM 4.1.4). Shown before that, the manager's reparent
+    /// would move and hide it again.
+    fn managed_overlay_refused(
+        &self,
+        window: xproto::Window,
+        x: i32,
+        y: i32,
+        width: u32,
+        height: u32,
+    ) -> anyhow::Result<()> {
+        crate::linux::overlay::unmanage(window as usize);
+        RELEASING.with_borrow_mut(|all| all.push((window, x, y, width, height)));
+        self.xcb_connection.unmap_window(window)?;
+        Ok(())
+    }
+
+    /// The window manager mapped `window`: a managed overlay that waits for the keys takes them,
+    /// and one the manager put elsewhere than it was given, or at another size, as a tiling one
+    /// does, becomes an override-redirect window there, as overlays are on X11 with no manager.
+    fn managed_overlay_mapped(&self, window: xproto::Window) -> anyhow::Result<()> {
+        let Some((_, x, y, width, height)) =
+            PLACED.with_borrow(|all| all.iter().copied().find(|&(each, ..)| each == window))
+        else {
+            return Ok(());
+        };
+        let xcb = &self.xcb_connection;
+        let root = xcb.setup().roots[self.x_root_index].root;
+        // Where it lets the pointer through, set again: Openbox gives its frame the input shape
+        // of a window it's mapped, as it changes, not the one it had as it was mapped.
+        if crate::linux::overlay::is_managed(window as usize) {
+            let areas = crate::linux::overlay::pointer_areas(window as usize);
+            self.overlay_pointer(window, areas.as_deref())?;
+        }
+        // Checked at its first map after it shows, not as the manager maps it again after a
+        // minimise or a desktop's change.
+        if !CHECK_ON_MAP.with_borrow_mut(|all| {
+            let first = all.contains(&window);
+            all.retain(|&each| each != window);
+            first
+        }) {
+            return self.managed_focus_on_map(window);
+        }
+        let at = xcb.translate_coordinates(window, root, 0, 0)?.reply()?;
+        let size = xcb.get_geometry(window)?.reply()?;
+        let kept = (i32::from(at.dst_x) - x).abs() <= 1
+            && (i32::from(at.dst_y) - y).abs() <= 1
+            && u32::from(size.width) == width
+            && u32::from(size.height) == height;
+        if kept || !crate::linux::overlay::is_managed(window as usize) {
+            self.managed_overlay_seen(window)?;
+        }
+        // One already unmanaged, mapped again, only takes the keys.
+        if !kept && crate::linux::overlay::is_managed(window as usize) {
+            eprintln!(
+                "browser: overlay {window:#x}: mapped at {},{} {}x{} for {x},{y} {width}x{height}, \
+                 so it asks the window manager again",
+                at.dst_x, at.dst_y, size.width, size.height,
+            );
+            // A manager may map it before it puts it in place, as KWin does a dialog it hasn't
+            // placed yet; its answer to a tool's move says whether it keeps it there.
+            match self.managed_move(window, x, y, Some((width, height)))? {
+                Some(seq) => ASKED_AGAIN.with_borrow_mut(|all| {
+                    all.retain(|&(each, _)| each != window);
+                    all.push((window, seq as u16));
+                }),
+                None => self.managed_overlay_refused(window, x, y, width, height)?,
+            }
+            xcb.flush()?;
+        }
+        self.managed_focus_on_map(window)
+    }
+
+    /// A managed overlay mapped by its manager takes the input focus if it waits for it.
+    fn managed_focus_on_map(&self, window: xproto::Window) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let waits = FOCUS_ON_MAP.with_borrow_mut(|all| {
+            let waits = all.contains(&window);
+            all.retain(|&each| each != window);
+            waits
+        });
+        if !waits || !crate::linux::overlay::is_shown(window as usize) {
+            return Ok(());
+        }
+        // Mapped inside a frame the manager hasn't mapped yet, it waits for that.
+        if xcb.get_window_attributes(window)?.reply()?.map_state != xproto::MapState::VIEWABLE {
+            FOCUS_ON_MAP.with_borrow_mut(|all| all.push(window));
+            return Ok(());
+        }
+        xcb.set_input_focus(xproto::InputFocus::PARENT, window, x11rb::CURRENT_TIME)?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// The browser's window `client` is on another desktop: each managed overlay over it goes
+    /// there too, as a manager that keeps a dialog with its window does already and i3 doesn't.
+    fn managed_follow_desktop(&self, client: xproto::Window) -> anyhow::Result<()> {
+        let views: Vec<_> = CLIENTS.with_borrow(|all| {
+            (all.iter())
+                .filter(|&&(view, each)| {
+                    each == client
+                        && crate::linux::overlay::is_managed(view as usize)
+                        && crate::linux::overlay::is_shown(view as usize)
+                })
+                .map(|&(view, _)| view)
+                .collect()
+        });
+        if views.is_empty() {
+            return Ok(());
+        }
+        let xcb = &self.xcb_connection;
+        let desktop = |window| -> anyhow::Result<Option<u32>> {
+            let reply = (xcb.get_property(
+                false,
+                window,
+                self.atoms._NET_WM_DESKTOP,
+                AtomEnum::CARDINAL,
+                0,
+                1,
+            )?)
+            .reply()?;
+            Ok(reply.value32().and_then(|mut each| each.next()))
+        };
+        let Some(to) = desktop(client)? else {
+            return Ok(());
+        };
+        let root = xcb.setup().roots[self.x_root_index].root;
+        for view in views {
+            if desktop(view)? == Some(to) {
+                continue;
+            }
+            // From a tool, as the move isn't the user's own.
+            let message = xproto::ClientMessageEvent::new(
+                32,
+                view,
+                self.atoms._NET_WM_DESKTOP,
+                [to, 2, 0, 0, 0],
+            );
+            xcb.send_event(
+                false,
+                root,
+                xproto::EventMask::SUBSTRUCTURE_REDIRECT | xproto::EventMask::SUBSTRUCTURE_NOTIFY,
+                message,
+            )?;
+        }
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// The window manager let go of `window`, a managed overlay it didn't keep in place: it put
+    /// it back on the root, or withdrew it in its WM_STATE. The overlay shows where it was put,
+    /// as an override-redirect window, as overlays are on X11 with no manager.
+    fn managed_overlay_released(&self, window: xproto::Window) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let root = xcb.setup().roots[self.x_root_index].root;
+        let Some((_, x, y, width, height)) =
+            RELEASING.with_borrow(|all| all.iter().copied().find(|&(each, ..)| each == window))
+        else {
+            return Ok(());
+        };
+        let parent = xcb.query_tree(window)?.reply()?.parent;
+        if parent != root {
+            let wm_state = xcb.intern_atom(true, b"WM_STATE")?.reply()?.atom;
+            let state = xcb.get_property(false, window, wm_state, AtomEnum::ANY, 0, 1)?.reply()?;
+            // Still held: neither back on the root nor withdrawn (state 0).
+            if state.value32().and_then(|mut each| each.next()).is_some_and(|each| each != 0) {
+                return Ok(());
+            }
+        }
+        RELEASING.with_borrow_mut(|all| all.retain(|&(each, ..)| each != window));
+        xcb.change_window_attributes(
+            window,
+            &xproto::ChangeWindowAttributesAux::new().override_redirect(1),
+        )?;
+        if parent != root {
+            xcb.reparent_window(window, root, x as i16, y as i16)?;
+        }
+        xcb.delete_property(window, self.atoms.WM_TRANSIENT_FOR)?;
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            window,
+            self.atoms._NET_WM_WINDOW_TYPE,
+            AtomEnum::ATOM,
+            &[self.atoms._NET_WM_WINDOW_TYPE_NOTIFICATION],
+        )?;
+        let top = OVER.with_borrow(|all| {
+            all.iter().find(|&&(each, ..)| each == window).map(|&(_, top, ..)| top)
+        });
+        let mut place = (xproto::ConfigureWindowAux::new())
+            .x(x)
+            .y(y)
+            .width(width)
+            .height(height)
+            .stack_mode(xproto::StackMode::ABOVE);
+        if let Some(top) = top {
+            place = place.sibling(self.kwin_support.unwrap_or(top));
+        }
+        xcb.configure_window(window, &place)?;
+        self.managed_overlay_seen(window)?;
+        // Hidden meanwhile, it stays hidden: showing it again maps it.
+        if crate::linux::overlay::is_shown(window as usize) {
+            xcb.map_window(window)?;
+        }
+        // A tiling manager gave the focus to its window as it mapped it, and to the browser's
+        // window as it let go, so an overlay with the keys, such as Peek under a toast, takes them
+        // again.
+        crate::linux::overlay::retake_keyboard(window as usize);
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// The child of the root `window` is in, such as a window manager's frame around it.
+    fn top_level(&self, window: xproto::Window) -> anyhow::Result<xproto::Window> {
+        let mut top = window;
+        loop {
+            let tree = self.xcb_connection.query_tree(top)?.reply()?;
+            if tree.parent == tree.root || tree.parent == x11rb::NONE {
+                return Ok(top);
+            }
+            top = tree.parent;
+        }
+    }
+
+    /// Whether `focus` is an overlay that shows, or the top-level `within` is in or inside it.
+    fn has_focus(&self, focus: xproto::Window, within: xproto::Window) -> anyhow::Result<bool> {
+        // None or PointerRoot: no window of this app's has it.
+        if focus == x11rb::NONE || focus == 1 {
+            return Ok(false);
+        }
+        if crate::linux::overlay::is_shown(focus as usize) {
+            return Ok(true);
+        }
+        let xcb = &self.xcb_connection;
+        let top = self.top_level(within)?;
+        let mut each = focus;
+        while each != top {
+            let tree = xcb.query_tree(each)?.reply()?;
+            if tree.parent == tree.root || tree.parent == x11rb::NONE {
+                return Ok(false);
+            }
+            each = tree.parent;
+        }
+        Ok(true)
+    }
+
+    /// Gives the input focus back to `from` if the overlay `view` still has it, and says whether
+    /// it did.
+    pub(crate) fn overlay_gives_focus(
+        &self,
+        view: xproto::Window,
+        from: xproto::Window,
+    ) -> anyhow::Result<bool> {
+        let xcb = &self.xcb_connection;
+        if from == x11rb::NONE || xcb.get_input_focus()?.reply()?.focus != view {
+            return Ok(false);
+        }
+        xcb.set_input_focus(xproto::InputFocus::PARENT, from, x11rb::CURRENT_TIME)?;
+        xcb.flush()?;
+        Ok(true)
+    }
+
+    /// Hides the overlay `view`, giving the input focus back to `from` if the overlay still has it,
+    /// and says whether the focus went elsewhere than either, as a press outside both takes it.
+    pub(crate) fn hide_overlay(
+        &self,
+        view: xproto::Window,
+        from: xproto::Window,
+    ) -> anyhow::Result<bool> {
+        let gave = self.overlay_gives_focus(view, from)?;
+        let focus = self.xcb_connection.get_input_focus()?.reply()?.focus;
+        let elsewhere = !gave && from != x11rb::NONE && focus != view && focus != from;
+        OVER.with_borrow_mut(|all| all.retain(|&(each, ..)| each != view));
+        PLACED.with_borrow_mut(|all| all.retain(|&(each, ..)| each != view));
+        FOCUS_ON_MAP.with_borrow_mut(|all| all.retain(|&each| each != view));
+        CHECK_ON_MAP.with_borrow_mut(|all| all.retain(|&each| each != view));
+        ASKED_AGAIN.with_borrow_mut(|all| all.retain(|&(each, _)| each != view));
+        UNPLACED.with_borrow_mut(|all| all.retain(|(each, _)| *each != view));
+        let away = AWAY.with_borrow_mut(|all| {
+            let top = all
+                .iter()
+                .find(|each| each.view == view)
+                .map(|each| each.top);
+            all.retain(|each| each.view != view);
+            top
+        });
+        if let Some(top) = away {
+            self.watch_top(top)?;
+        }
+        let xcb = &self.xcb_connection;
+        xcb.unmap_window(view)?;
+        xcb.flush()?;
+        Ok(elsewhere)
+    }
+
+    /// The window manager hid `top`, the top-level overlays show over: they go off screen with it,
+    /// and the keyboard leaving one then isn't the user leaving it. `top` is watched for the input
+    /// focus until the one with the keys has them back (`overlay_keys_back`).
+    fn overlays_away(&self, top: xproto::Window) -> anyhow::Result<()> {
+        let views: Vec<_> = OVER.with_borrow(|all| {
+            (all.iter())
+                .filter(|&&(_, each, ..)| each == top)
+                .map(|&(view, ..)| view)
+                .collect()
+        });
+        if views.is_empty() {
+            return Ok(());
+        }
+        let xcb = &self.xcb_connection;
+        for view in views {
+            // A shadow under another overlay, which shows only where a compositor blends it.
+            let attributes = xcb.get_window_attributes(view)?.reply()?;
+            if attributes.map_state == xproto::MapState::UNMAPPED
+                || AWAY.with_borrow(|all| all.iter().any(|each| each.view == view))
+            {
+                continue;
+            }
+            let keyboard = crate::linux::overlay::set_away(view as usize, true);
+            AWAY.with_borrow_mut(|all| {
+                all.push(Away {
+                    view,
+                    top,
+                    keyboard,
+                    back: false,
+                })
+            });
+            // The manager hides a managed one with the window it's transient for, and would take
+            // the overlay unmapping itself as it letting go of the window.
+            if !crate::linux::overlay::is_managed(view as usize) {
+                xcb.unmap_window(view)?;
+            }
+        }
+        self.watch_top(top)?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// The window manager shows `top` again: its overlays come back over it, in their order. The
+    /// one with the keys takes them once the window manager gives `top` the input focus, as a
+    /// window manager does to a window it shows again, rather than racing it for them now.
+    fn overlays_back(&self, top: xproto::Window) -> anyhow::Result<()> {
+        let back: Vec<_> = AWAY.with_borrow_mut(|all| {
+            (all.iter_mut())
+                .filter(|each| each.top == top && !each.back)
+                .map(|each| {
+                    each.back = true;
+                    (each.view, each.keyboard)
+                })
+                .collect()
+        });
+        if back.is_empty() {
+            return Ok(());
+        }
+        let xcb = &self.xcb_connection;
+        for &(view, keyboard) in &back {
+            // The window manager shows a managed one again, so it takes the keys as it maps
+            // (`overlay_takes_focus`).
+            if crate::linux::overlay::is_managed(view as usize) {
+                if !keyboard {
+                    crate::linux::overlay::set_away(view as usize, false);
+                    AWAY.with_borrow_mut(|all| all.retain(|each| each.view != view));
+                }
+                continue;
+            }
+            xcb.map_window(view)?;
+            let over = (xproto::ConfigureWindowAux::new())
+                .sibling(self.kwin_support.unwrap_or(top))
+                .stack_mode(xproto::StackMode::ABOVE);
+            xcb.configure_window(view, &over)?;
+            if !keyboard {
+                crate::linux::overlay::set_away(view as usize, false);
+                AWAY.with_borrow_mut(|all| all.retain(|each| each.view != view));
+            }
+        }
+        // One that shows under another goes back under it.
+        for &(view, _) in &back {
+            if let Some(above) = crate::linux::overlay::under(view as usize)
+                .filter(|&above| crate::linux::overlay::is_shown(above))
+            {
+                let under = (xproto::ConfigureWindowAux::new())
+                    .sibling(above as xproto::Window)
+                    .stack_mode(xproto::StackMode::BELOW);
+                xcb.configure_window(view, &under)?;
+            }
+        }
+        self.watch_top(top)?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// The window manager gave `top`, shown again, the input focus: the overlay over it that had
+    /// the keys takes them back, as it had them when `top` was hidden.
+    fn overlay_keys_back(&self, top: xproto::Window) -> anyhow::Result<()> {
+        let views: Vec<_> = AWAY.with_borrow_mut(|all| {
+            let views = (all.iter())
+                .filter(|each| each.top == top && each.back)
+                .map(|each| each.view)
+                .collect();
+            all.retain(|each| !(each.top == top && each.back));
+            views
+        });
+        for view in views {
+            crate::linux::overlay::set_away(view as usize, false);
+            if crate::linux::overlay::is_shown(view as usize) {
+                self.overlay_takes_focus(view, None)?;
+            }
+        }
+        self.watch_top(top)
+    }
+
+    /// Watches the top-level `top` for its moves and raises, and while an overlay over it waits to
+    /// take the keys back, for the input focus.
+    fn watch_top(&self, top: xproto::Window) -> anyhow::Result<()> {
+        if self.windows.contains_key(&top) {
+            return Ok(());
+        }
+        let mut watch = xproto::EventMask::STRUCTURE_NOTIFY;
+        if AWAY.with_borrow(|all| all.iter().any(|each| each.top == top && each.keyboard)) {
+            watch |= xproto::EventMask::FOCUS_CHANGE;
+        }
+        // The browser's window with no frame, whose desktop managed overlays follow.
+        if CLIENTS.with_borrow(|all| all.iter().any(|&(_, each)| each == top)) {
+            watch |= xproto::EventMask::PROPERTY_CHANGE;
+        }
+        let xcb = &self.xcb_connection;
+        xcb.change_window_attributes(
+            top,
+            &xproto::ChangeWindowAttributesAux::new().event_mask(watch),
+        )?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// Shows `view`, a window of GPUI's opened with `show: false`, as a window of its own, in front
+    /// and with the input focus, centred over the top-level window `over` is in unless it's none.
+    pub(crate) fn show_window(
+        &self,
+        view: xproto::Window,
+        over: xproto::Window,
+    ) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let root = xcb.get_geometry(view)?.reply()?.root;
+        if over != x11rb::NONE {
+            let top = self.top_level(over)?;
+            let frame = xcb.get_geometry(top)?.reply()?;
+            let corner = xcb.translate_coordinates(top, root, 0, 0)?.reply()?;
+            let own = xcb.get_geometry(view)?.reply()?;
+            let x = i32::from(corner.dst_x) + (i32::from(frame.width) - i32::from(own.width)) / 2;
+            let y = i32::from(corner.dst_y) + (i32::from(frame.height) - i32::from(own.height)) / 2;
+            xcb.configure_window(
+                view,
+                &xproto::ConfigureWindowAux::new().x(x.max(0)).y(y.max(0)),
+            )?;
+        }
+        // A window manager that keeps the focus from an app that asks for it, as sway's and
+        // Hyprland's do by default, still gives it to a window as it maps, so one that shows behind
+        // another maps again.
+        let viewable = xcb.get_window_attributes(view)?.reply()?.map_state == xproto::MapState::VIEWABLE;
+        if viewable && xcb.get_input_focus()?.reply()?.focus != view {
+            xcb.unmap_window(view)?;
+        }
+        xcb.map_window(view)?;
+        // As GPUI's activate asks: the window manager raises it and gives it the focus.
+        let message = xproto::ClientMessageEvent::new(
+            32,
+            view,
+            self.atoms._NET_ACTIVE_WINDOW,
+            [1, x11rb::CURRENT_TIME, 0, 0, 0],
+        );
+        xcb.send_event(
+            false,
+            root,
+            xproto::EventMask::SUBSTRUCTURE_REDIRECT | xproto::EventMask::SUBSTRUCTURE_NOTIFY,
+            message,
+        )?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    pub(crate) fn hide_window(&self, view: xproto::Window) -> anyhow::Result<()> {
+        self.xcb_connection.unmap_window(view)?;
+        self.xcb_connection.flush()?;
+        Ok(())
+    }
+
+    /// The size of `window`, such as the embedder's or an overlay, in logical pixels.
+    pub(crate) fn window_size(&self, window: xproto::Window) -> anyhow::Result<Size<Pixels>> {
+        let geometry = self.xcb_connection.get_geometry(window)?.reply()?;
+        Ok(size(
+            px(f32::from(geometry.width) / self.scale_factor),
+            px(f32::from(geometry.height) / self.scale_factor),
+        ))
+    }
