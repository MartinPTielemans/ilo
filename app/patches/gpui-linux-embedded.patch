+/// then, which it would leave to the embedder; the shortcut's press is where both find the keys
+/// to give it. Only the keystroke's key and modifiers count. With no `shortcut`, GPUI has it
+/// itself, in the press it's handling, and holds the keys after that. On X11 GPUI has none to hold.
+pub fn hold_keys(#[allow(unused_variables)] shortcut: Option<&gpui::Keystroke>) {
+    #[cfg(feature = "wayland")]
+    super::wayland::hold_keys(shortcut);
+}
