+/// Starts the data device's drag of `data`, as `mime`, from the surface the left button is held in
+/// (`file_drag::start_drag`).
+pub(crate) fn start_drag(mime: &str, data: Vec<u8>) -> bool {
+    let Some(client) = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade()) else {
+        return false;
+    };
+    let mut state = client.borrow_mut();
+    let Some(window) = state.mouse_focused_window.clone() else {
+        return false;
+    };
+    let (Some(manager), Some(device)) = (
+        state.globals.data_device_manager.as_ref(),
+        state.data_device.as_ref(),
+    ) else {
+        return false;
+    };
+    let serial = state.serial_tracker.get(SerialKind::MousePress);
+    let source = manager.create_data_source(&state.globals.qh, DataSourceKind::Drag);
+    source.offer(mime.to_string());
+    source.set_actions(DndAction::Copy);
+    // Empty until the embedder gives it its picture (`set_drag_icon`), which the compositor shows
+    // once it's committed.
+    let icon = state.globals.compositor.create_surface(&state.globals.qh, ());
+    device.start_drag(Some(&source), &window.surface(), Some(&icon), serial.as_raw());
+    state.external_drag = Some(ExternalDrag {
+        source,
+        bytes: data,
+        window: window.clone(),
+        dropped: false,
+        icon: Some(DragIcon {
+            surface: icon,
+            buffer: None,
+            viewport: None,
+        }),
+    });
+    drop(state);
+    flush(&window);
+    true
+}
+
+/// Shows `rgba`, `width` by `height` top-down RGBA pixels at `scale` device pixels a logical one,
+/// as the picture of the drag `start_drag` started, with the pointer at `hold` in it, in its
+/// pixels. The data device's icon surface takes it, in a shared-memory buffer.
+pub(crate) fn set_drag_icon(
+    width: u32,
+    height: u32,
+    rgba: &[u8],
+    hold: (i32, i32),
+    scale: f32,
+) -> bool {
+    let Some(client) = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade()) else {
+        return false;
+    };
+    let mut state = client.borrow_mut();
+    let state = &mut *state;
+    if (state.external_drag.as_ref()).is_none_or(|drag| drag.icon.is_none()) {
+        return false;
+    }
+    if width == 0 || height == 0 || rgba.len() != width as usize * height as usize * 4 {
+        return false;
+    }
+    // Wayland's ARGB8888 is BGRA in memory.
+    let bgra: Vec<u8> = (rgba.chunks_exact(4))
+        .flat_map(|pixel| [pixel[2], pixel[1], pixel[0], pixel[3]])
+        .collect();
+    let Some(buffer) = shm_buffer(state, width, height, &bgra) else {
+        return false;
+    };
+    let qh = &state.globals.qh;
+    let Some(icon) = (state.external_drag.as_mut()).and_then(|drag| drag.icon.as_mut()) else {
+        return false;
+    };
+    let surface = &icon.surface;
+    // In logical pixels, as the surface is: drawn at the window's scale, with a viewport where
+    // that's fractional, else the buffer's scale.
+    let logical = |n: i32| (n as f32 / scale).round() as i32;
+    match &state.globals.viewporter {
+        Some(viewporter) if scale.fract() != 0. => {
+            let viewport = (icon.viewport)
+                .get_or_insert_with(|| viewporter.get_viewport(surface, qh, ()));
+            viewport.set_destination(logical(width as i32), logical(height as i32));
+        }
+        _ => surface.set_buffer_scale(scale.round().max(1.) as i32),
+    }
+    let (dx, dy) = (-logical(hold.0), -logical(hold.1));
+    if surface.version() >= 5 {
+        surface.offset(dx, dy);
+        surface.attach(Some(&buffer), 0, 0);
+    } else {
+        surface.attach(Some(&buffer), dx, dy);
+    }
+    surface.damage_buffer(0, 0, width as i32, height as i32);
+    surface.commit();
+    if let Some(old) = icon.buffer.replace(buffer) {
+        old.destroy();
+    }
+    if let Some(drag) = &state.external_drag {
+        flush(&drag.window);
+    }
+    true
+}
+
+/// A buffer of `bgra`, `width` by `height` pixels, in memory shared with the compositor.
+fn shm_buffer(
+    state: &WaylandClientState,
+    width: u32,
+    height: u32,
+    bgra: &[u8],
+) -> Option<wl_buffer::WlBuffer> {
+    let size = bgra.len();
+    let fd = shm_file(size)?;
+    let file = fd.try_clone().map(std::fs::File::from).ok()?;
+    std::os::unix::fs::FileExt::write_all_at(&file, bgra, 0).ok()?;
+    let qh = &state.globals.qh;
+    let pool = (state.globals.shm).create_pool(std::os::fd::AsFd::as_fd(&fd), size as i32, qh, ());
+    let buffer = pool.create_buffer(
+        0,
+        width as i32,
+        height as i32,
+        width as i32 * 4,
+        wl_shm::Format::Argb8888,
+        qh,
+        (),
+    );
+    pool.destroy();
+    Some(buffer)
+}
+
+/// An anonymous file of `size` bytes, to share with the compositor.
+fn shm_file(size: usize) -> Option<std::os::fd::OwnedFd> {
+    use std::os::fd::FromRawFd as _;
+    let fd = unsafe { libc::memfd_create(c"gpui-drag-icon".as_ptr(), libc::MFD_CLOEXEC) };
+    if fd < 0 {
+        return None;
+    }
+    let fd = unsafe { std::os::fd::OwnedFd::from_raw_fd(fd) };
+    (unsafe { libc::ftruncate(fd.as_raw_fd(), size as libc::off_t) } == 0).then_some(fd)
+}
