+/// The rows of the polygon through `corners`, each x, y and the radius it's rounded by, in device
+/// pixels, for a shape `height` rows tall: each row's spans through the middle of its pixels, or,
+/// `touching`, with every pixel the polygon touches, so that the edges GPUI smooths are inside it.
+fn outline_rows(corners: &[(f32, f32, f32)], height: i16, touching: bool) -> Vec<xproto::Rectangle> {
+    let points = rounded_polygon(corners);
+    let spans = |y: f32| {
+        let mut crossings: Vec<f32> = (points.iter())
+            .zip(points.iter().cycle().skip(1))
+            .filter(|(a, b)| (a.1 <= y) != (b.1 <= y))
+            .map(|(a, b)| a.0 + (y - a.1) / (b.1 - a.1) * (b.0 - a.0))
+            .collect();
+        crossings.sort_by(f32::total_cmp);
+        crossings
+    };
+    let mut rows = Vec::new();
