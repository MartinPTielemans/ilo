+/// The embedder answered the press of `shortcut` as a shortcut of its own, before its page had it.
+/// Under Wayland GPUI reads that press after the embedder, and the answer can have given GPUI's
+/// window the keys, as closing the page that had them does, so GPUI drops the press rather than
+/// run the shortcut a second time. On X11 the press reaches only the embedder.
+pub fn answered_key(#[allow(unused_variables)] shortcut: &gpui::Keystroke) {
+    #[cfg(feature = "wayland")]
+    super::wayland::answered_key(shortcut);
+}
