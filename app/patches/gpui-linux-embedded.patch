+/// Whether Control is held in the embedder's surfaces, as their keys last said.
+pub(crate) fn control_held() -> bool {
+    let client = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade());
+    client.is_some_and(|client| client.borrow().modifiers.control)
+}
