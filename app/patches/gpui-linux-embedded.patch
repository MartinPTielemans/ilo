+/// The keys GPUI has after a shortcut that opens an overlay with the keyboard (`hold_keys`). Every
+/// key reaches both the embedder and GPUI, and the shortcut's press is the one place in the keys
+/// both know: the embedder's copies of the keys after it are its page's only if no overlay takes
+/// them, and GPUI's go to the overlay that does. For a shortcut GPUI handles itself, they're those
+/// after the press it's handling.
+struct HeldKeys {
+    /// None for one GPUI had itself, whose press it was handling (`hold_keys`).
+    shortcut: Option<Keystroke>,
+    since: Instant,
+    /// Whether GPUI has had the shortcut's press, after which it holds the keys.
+    after: bool,
+    keys: Vec<PlatformInput>,
+    /// The overlay that takes them (`give_held_keys`).
+    to: Option<usize>,
+}
+
+thread_local! {
+    static HELD_KEYS: RefCell<Option<HeldKeys>> = const { RefCell::new(None) };
+}
+
+/// As long as the embedder holds them (bc_hold_keys): past it, its page kept the shortcut.
+const HOLD_KEYS_FOR: Duration = Duration::from_millis(400);
+
+pub(crate) fn hold_keys(shortcut: Option<&Keystroke>) {
+    if EMBEDDED_CLIENT.with_borrow(|client| client.is_none()) {
+        return;
+    }
+    HELD_KEYS.set(Some(HeldKeys {
+        shortcut: shortcut.cloned(),
+        since: Instant::now(),
+        after: shortcut.is_none(),
+        keys: Vec::new(),
+        to: None,
+    }));
+}
+
+pub(crate) fn give_held_keys(view: usize) -> bool {
+    HELD_KEYS.with_borrow_mut(|held| {
+        if held.as_ref().is_some_and(expired) {
+            *held = None;
+        }
+        if let Some(held) = held.as_mut() {
+            held.to = Some(view);
+        }
+        held.is_some()
+    })
+}
+
+fn expired(held: &HeldKeys) -> bool {
+    held.since.elapsed() > HOLD_KEYS_FOR
+}
+
+/// Gives the overlay that took the keys held (`give_held_keys`) them once it shows with the
+/// keyboard, before GPUI gives it those typed later.
+pub(crate) fn deliver_held_keys() {
+    let ready = crate::linux::overlay::keyboard_overlay();
+    let held = HELD_KEYS.with_borrow_mut(|held| {
+        let to = held.as_ref()?.to?;
+        (ready == Some(to)).then(|| held.take()).flatten()
+    });
+    let Some(held) = held else {
+        return;
+    };
+    if let Some(window) = held.to.and_then(|to| overlay_window(to as _)) {
+        for key in held.keys {
+            window.handle_input(key);
+        }
+    }
+}
+
+/// Whether the key `key`, pressed or released as `key_state` says, is held for an overlay
+/// (`hold_keys`), which it then is. A hold that no overlay showed for in time ends with its keys.
+fn holds_key(state: &WaylandClientState, key: u32, key_state: wl_keyboard::KeyState) -> bool {
+    HELD_KEYS.with_borrow_mut(|slot| {
+        let Some(held) = slot.as_mut() else {
+            return false;
+        };
+        if expired(held) {
+            *slot = None;
+            return false;
+        }
+        let Some(keymap_state) = state.keymap_state.as_ref() else {
+            return false;
+        };
+        let keycode = Keycode::from(key + MIN_KEYCODE);
+        if keymap_state.key_get_one_sym(keycode).is_modifier_key() {
+            return false;
+        }
+        let keystroke = keystroke_from_xkb(keymap_state, state.modifiers, keycode);
+        let input = match key_state {
+            wl_keyboard::KeyState::Pressed => PlatformInput::KeyDown(KeyDownEvent {
+                keystroke,
+                is_held: false,
+                prefer_character_input: false,
+            }),
+            wl_keyboard::KeyState::Released => PlatformInput::KeyUp(KeyUpEvent { keystroke }),
+            _ => return false,
+        };
+        if !held.after {
+            held.after = match (&input, &held.shortcut) {
+                (PlatformInput::KeyDown(down), Some(shortcut)) => {
+                    down.keystroke.key == shortcut.key
+                        && down.keystroke.modifiers == shortcut.modifiers
+                }
+                _ => false,
+            };
+            return false;
+        }
+        held.keys.push(input);
+        true
+    })
+}
+
+thread_local! {
+    /// The press the embedder answered as a shortcut of its own (`answered_key`), which GPUI has
+    /// yet to read, and since when.
+    static ANSWERED_KEY: RefCell<Option<(Keystroke, Instant)>> = const { RefCell::new(None) };
+}
+
+pub(crate) fn answered_key(shortcut: &Keystroke) {
+    if EMBEDDED_CLIENT.with_borrow(|client| client.is_none()) {
+        return;
+    }
+    ANSWERED_KEY.set(Some((shortcut.clone(), Instant::now())));
+}
+
+/// Whether the key `key`, pressed or released as `key_state` says, is the press the embedder
+/// answered (`answered_key`), which GPUI then drops. The key's next press is that one, as the
+/// embedder reads each key first; its release ends the mark too, since an answer to a repeat the
+/// embedder made has no press of GPUI's to drop.
+fn answered_press(state: &WaylandClientState, key: u32, key_state: wl_keyboard::KeyState) -> bool {
+    let Some((shortcut, since)) = ANSWERED_KEY.take() else {
+        return false;
+    };
+    let Some(keymap_state) = state.keymap_state.as_ref() else {
+        return false;
+    };
+    let keycode = Keycode::from(key + MIN_KEYCODE);
+    let keystroke = keystroke_from_xkb(keymap_state, state.modifiers, keycode);
+    let keyed = !keymap_state.key_get_one_sym(keycode).is_modifier_key()
+        && keystroke.key == shortcut.key;
+    if since.elapsed() > HOLD_KEYS_FOR
+        || keyed && key_state == wl_keyboard::KeyState::Released
+    {
+        return false;
+    }
+    let answered = keyed
+        && key_state == wl_keyboard::KeyState::Pressed
+        && keystroke.modifiers == shortcut.modifiers;
+    if !answered {
+        ANSWERED_KEY.set(Some((shortcut, since)));
+    }
+    answered
+}
+
+fn overlay_window(view: *mut std::ffi::c_void) -> Option<WaylandWindowStatePtr> {
+    let client = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade())?;
+    let state = client.borrow();
+    window_with_surface(&state, view as usize)
+}
+
+fn flush(window: &WaylandWindowStatePtr) {
+    if let Some(backend) = window.surface().backend().upgrade() {
+        backend.flush().ok();
+    }
+}
+
+/// The key GPUI repeats while it's held in the embedder's surfaces, as its keysym and a number
+/// that changes with each press: None once it's let go. Every key reaches both the embedder and
+/// GPUI, so the embedder's own repeats of a key GPUI had the press of are the held key's.
+pub fn held_key() -> Option<(u32, u64)> {
+    let client = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade())?;
+    let state = client.borrow();
+    let keycode = state.repeat.current_keycode?;
+    let keysym = state.keymap_state.as_ref()?.key_get_one_sym(keycode);
+    Some((keysym.raw(), state.repeat.current_id))
+}
+
+/// Whether the compositor has given the keyboard to one of GPUI's windows or the embedder's.
+pub(crate) fn keyboard_entered() -> bool {
+    EMBEDDED_CLIENT
+        .with_borrow(|client| client.as_ref()?.upgrade())
+        .is_some_and(|client| client.borrow().keyboard_focused_window.is_some())
+}
+
+/// Has the compositor answer GPUI on the embedder's display, which the embedder reads, and then
+/// dispatches GPUI (`crate::linux::dispatch_embedded_after_read`).
+pub(crate) fn wake_after_read() {
+    let Some(client) = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade()) else {
+        return;
+    };
+    let Some(window) = embedded_windows().into_iter().next() else {
+        return;
+    };
+    let Some(backend) = window.surface().backend().upgrade() else {
+        return;
+    };
+    let connection = Connection::from_backend(backend);
+    let Ok(qh) = client.try_borrow().map(|client| client.globals.qh.clone()) else {
+        return;
+    };
+    // A callback for no surface, which its handler ignores.
+    connection.display().sync(&qh, ObjectId::null());
+    connection.flush().ok();
+}
+
+/// Shows the overlay window of the `view` surface over the embedder's `parent` surface, or over
+/// GPUI's own window of that surface, one the embedder showed (`show_window`), as a menu over an
+/// app's settings (`crate::linux::show_overlay`), with the keys if `keyboard`.
+pub(crate) fn show_overlay(
+    view: *mut std::ffi::c_void,
+    parent: *mut std::ffi::c_void,
+    bounds: Bounds<Pixels>,
+    keyboard: bool,
+) -> anyhow::Result<()> {
+    let window = overlay_window(view).context("no window has the overlay's surface")?;
+    let (parent, scale) = match embedded_window_with_parent(parent) {
+        Some(embedded) => (embedded.embedded_parent_surface(), embedded.scale()),
+        None => match overlay_window(parent) {
+            Some(own) => (Some(own.surface()), own.scale()),
+            None => (None, 1.),
+        },
+    };
+    let parent = parent.context("GPUI has no window in or of the overlay's parent")?;
+    // Its first frame at the scale of the window it shows over: its own surface hears its scale
+    // from the compositor only once it's on screen, and kept the last one, from over a window on
+    // a display at another scale, or from where it was made (#2592).
+    window.rescale(scale);
+    window.show_over(&parent, bounds)?;
+    if keyboard {
+        window.set_focused(true);
+    }
+    refresh_embedded_text_input_of(&window);
+    flush(&window);
+    Ok(())
+}
+
+pub(crate) fn move_overlay(view: *mut std::ffi::c_void, bounds: Bounds<Pixels>) {
+    if let Some(window) = overlay_window(view) {
+        window.move_over(bounds);
+        refresh_embedded_text_input_of(&window);
+        flush(&window);
+    }
+}
+
+/// Stacks the overlay window of the `under` surface directly under that of `over`, both showing.
+pub(crate) fn place_overlay_under(under: *mut std::ffi::c_void, over: *mut std::ffi::c_void) {
+    if let (Some(window), Some(above)) = (overlay_window(under), overlay_window(over)) {
+        window.place_under(&above);
+        flush(&window);
+    }
+}
+
+/// The overlay window of the `view` surface takes the pointer only in `areas`, or all over, from
+/// its next frame, which `redraw` asks for.
+pub(crate) fn overlay_pointer(
+    view: *mut std::ffi::c_void,
+    areas: Option<&[Bounds<Pixels>]>,
+    redraw: bool,
+) {
+    // Not through a WaylandWindow, whose drop would close the window.
+    if let Some(window) = overlay_window(view) {
+        window.set_input_region(areas, redraw);
+        flush(&window);
+    }
+}
+
+/// The overlay window of the `view` surface that shows takes the keys, or gives them back.
+pub(crate) fn overlay_keyboard(view: *mut std::ffi::c_void, keyboard: bool) {
+    if let Some(window) = overlay_window(view) {
+        window.set_focused(keyboard);
+        refresh_embedded_text_input_of(&window);
+    }
+}
+
+/// Shows the window of the `view` surface, opened with `show: false`, as a toplevel of its own
+/// (`crate::linux::show_window`).
+pub(crate) fn show_window(view: *mut std::ffi::c_void) -> anyhow::Result<()> {
+    let window = overlay_window(view).context("no window has the surface")?;
+    window.show_toplevel()?;
+    flush(&window);
+    Ok(())
+}
+
+pub(crate) fn hide_window(view: *mut std::ffi::c_void) {
+    if let Some(window) = overlay_window(view) {
+        window.hide_toplevel();
+        flush(&window);
+    }
+}
+
+/// The overlay window of the `view` surface is to hide: see `hiding_over`.
+pub(crate) fn overlay_hiding(view: *mut std::ffi::c_void) {
+    if let Some(window) = overlay_window(view) {
+        window.hiding_over();
+    }
+}
+
+pub(crate) fn hide_overlay(view: *mut std::ffi::c_void, keyboard: bool) {
+    if let Some(window) = overlay_window(view) {
+        if keyboard {
+            window.set_focused(false);
+        }
+        let parent = window.embedder_surface();
+        window.hide_over();
+        if let Some((parent, _)) = parent {
+            refresh_embedded_text_input(parent);
+        }
+        flush(&window);
+    }
+}
