+/// What a set of pipelines is built for: a renderer with the same can use them.
+#[derive(Clone, Copy, PartialEq)]
+struct PipelineKey {
+    surface_format: wgpu::TextureFormat,
+    alpha_mode: wgpu::CompositeAlphaMode,
+    path_sample_count: u32,
+    dual_source_blending: bool,
+}
+
+/// The bind group layouts and pipelines of a device, built once for all its renderers. Compiling
+/// them takes long on a software rasterizer such as llvmpipe, and each window built its own, twice
+/// for a transparent one (#1028).
+#[derive(Default)]
+pub(crate) struct PipelineCache {
+    layouts: parking_lot::Mutex<Option<Arc<WgpuBindGroupLayouts>>>,
+    pipelines: parking_lot::Mutex<Vec<(PipelineKey, Arc<WgpuPipelines>)>>,
+}
+
+impl PipelineCache {
+    fn layouts(
+        &self,
+        device: &wgpu::Device,
+        uses_webgl_instance_data: bool,
+    ) -> Arc<WgpuBindGroupLayouts> {
+        self.layouts
+            .lock()
+            .get_or_insert_with(|| {
+                Arc::new(WgpuRendererCore::create_bind_group_layouts(
+                    device,
+                    uses_webgl_instance_data,
+                ))
+            })
+            .clone()
+    }
+
+    fn pipelines(
+        &self,
+        device: &wgpu::Device,
+        layouts: &WgpuBindGroupLayouts,
+        key: PipelineKey,
+        uses_webgl_instance_data: bool,
+    ) -> Arc<WgpuPipelines> {
+        let mut pipelines = self.pipelines.lock();
+        if let Some((_, shared)) = pipelines.iter().find(|(built, _)| *built == key) {
+            return shared.clone();
+        }
+        let built = Arc::new(WgpuRendererCore::create_pipelines(
+            device,
+            layouts,
+            key.surface_format,
+            key.alpha_mode,
+            key.path_sample_count,
+            key.dual_source_blending,
+            uses_webgl_instance_data,
+        ));
+        pipelines.push((key, built.clone()));
+        built
+    }
+}
