+impl WgpuRenderer {
+    /// Draws `scene` as `draw` does, into a texture of its own rather than the window's, which
+    /// isn't presented, and reads it back: its width, height and top-down RGBA rows, at the
+    /// window's scale.
+    #[cfg(not(target_family = "wasm"))]
+    pub fn render_to_image(&mut self, scene: &Scene) -> anyhow::Result<(u32, u32, Vec<u8>)> {
+        let size = self.viewport_size();
+        let premultiplied_alpha =
+            self.surface_config.alpha_mode == wgpu::CompositeAlphaMode::PreMultiplied;
+        let RendererState::Ready { core, .. } = &mut self.state else {
+            anyhow::bail!("the renderer has no surface to draw for");
+        };
+        anyhow::ensure!(size.width.0 > 0 && size.height.0 > 0, "nothing drawn");
+        let texture = core.resources.device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("window_image"),
+            size: wgpu::Extent3d {
+                width: size.width.0 as u32,
+                height: size.height.0 as u32,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: core.target_format,
+            usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+            view_formats: &[],
+        });
+        let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+        core.render_frame(scene, &view, size, premultiplied_alpha, wgpu::Color::TRANSPARENT)?;
+        read_texture(core, &texture)
+    }
+}
