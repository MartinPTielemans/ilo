@@ -413,3 +413,39 @@ pub struct GpuSpecs {
     /// Further information about the driver, as reported by Vulkan.
     pub driver_info: String,
 }
+
+/// Proof only (#2384): a launch mark on stderr, in ms from the process's start as the app's
+/// milestones are, with the calling thread's CPU time, for the first 400 marks.
+#[cfg(target_os = "linux")]
+pub fn launch_mark(what: &str) {
+    use std::sync::OnceLock;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static COUNT: AtomicUsize = AtomicUsize::new(0);
+    static START: OnceLock<f64> = OnceLock::new();
+    if COUNT.fetch_add(1, Ordering::Relaxed) >= 400 {
+        return;
+    }
+    let now = |clock| {
+        let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        unsafe { libc::clock_gettime(clock, &mut t) };
+        t.tv_sec as f64 * 1e3 + t.tv_nsec as f64 / 1e6
+    };
+    let start = *START.get_or_init(|| {
+        let stat = std::fs::read_to_string("/proc/self/stat").unwrap_or_default();
+        let ticks: f64 = stat
+            .rsplit_once(')')
+            .and_then(|(_, rest)| rest.split_whitespace().nth(19))
+            .and_then(|s| s.parse().ok())
+            .unwrap_or(0.);
+        ticks * 1e3 / unsafe { libc::sysconf(libc::_SC_CLK_TCK) } as f64
+    });
+    eprintln!(
+        "browser: mark {what} at {:.1} ms, cpu {:.1} ms",
+        now(libc::CLOCK_BOOTTIME) - start,
+        now(libc::CLOCK_THREAD_CPUTIME_ID)
+    );
+}
+
+/// Proof only (#2384): marks only on Linux.
+#[cfg(not(target_os = "linux"))]
+pub fn launch_mark(_: &str) {}
