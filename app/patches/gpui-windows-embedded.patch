+/// For an embedder's test driver, where there's no precision touchpad to stand in for, as no window
+/// message carries one's start and lift: two fingers at `x`, `y` in GPUI's window `hwnd`, in its
+/// client area's pixels, moving the content by `delta`, as the Direct Manipulation handler reports
+/// them. Returns whether the window had a view to hand them to.
+pub fn drive_fingers(
+    hwnd: *mut std::ffi::c_void,
+    x: f32,
+    y: f32,
+    delta: Point<Pixels>,
+    touch_phase: TouchPhase,
+) -> bool {
+    let Some(window) = window_from_hwnd(HWND(hwnd)) else {
+        return false;
+    };
+    let Some(mut func) = window.state.callbacks.input.take() else {
+        return false;
+    };
+    func(PlatformInput::Scroll(ScrollEvent {
+        position: logical_point(x, y, window.state.scale_factor.get()),
+        delta: ScrollDelta::Pixels(delta),
+        modifiers: current_modifiers(),
+        touch_phase,
+        source: ScrollSource::Pointer,
+    }));
+    window.state.callbacks.input.set(Some(func));
+    true
+}
