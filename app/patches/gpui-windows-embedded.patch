+/// Whether a window is handing input to its callback, and what came meanwhile, which a message
+/// loop nested in the callback delivers, as a browser engine's can (#3358). Dropped, a press made
+/// a click do nothing and a key a keystroke, so it's held as the Mac (#2658) and Linux hold it.
+#[derive(Default)]
+pub(crate) struct InputHeld {
+    busy: bool,
+    queue: VecDeque<Held>,
+}
+
+enum Held {
+    /// Input, with the text a key down's translation queued, typed where its `WM_CHAR` would have
+    /// been once the key's handed on.
+    Input(PlatformInput, Option<String>),
+    /// A change from an input method or a `WM_CHAR` to the field that had the keys when it came.
+    Text(Option<FocusId>, Box<dyn FnOnce(&mut PlatformInputHandler)>),
+}
+
+/// What became of input handed to the window (`hand_on`).
+pub(crate) enum Handed {
+    Now(DispatchEventResult),
+    /// It waits behind the input the callback is handling.
+    Held,
+}
+
+impl Handed {
+    /// The window procedure's answer: 0 where GPUI took the input or will, else 1.
+    fn answer(handed: Option<Self>) -> Option<isize> {
+        match handed {
+            Some(Handed::Now(result)) if result.propagate => Some(1),
+            None => Some(1),
+            _ => Some(0),
+        }
+    }
+}
