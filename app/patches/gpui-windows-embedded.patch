+/// For an embedder's test driver, which types as a Japanese input method would where there's none:
+/// in the text field with the keys in GPUI's window `hwnd`, marks `text`, with `selected` of it
+/// selected, in place of what was composed, or with `text` empty takes the composition out, as
+/// cancelling one does. Returns whether the window has a field with the keys.
+pub fn drive_compose(
+    hwnd: *mut std::ffi::c_void,
+    text: &str,
+    selected: Option<std::ops::Range<usize>>,
+) -> bool {
+    window_from_hwnd(HWND(hwnd))
+        .and_then(|window| {
+            window.with_input_handler(|handler| match text.is_empty() {
+                true => {
+                    if let Some(marked) = handler.marked_text_range() {
+                        handler.replace_text_in_range(Some(marked), "");
+                    }
+                }
+                false => handler.replace_and_mark_text_in_range(None, text, selected),
+            })
+        })
+        .is_some()
+}
+
+/// As `drive_compose`: commits `text` in place of what was composed.
+pub fn drive_commit(hwnd: *mut std::ffi::c_void, text: &str) -> bool {
+    window_from_hwnd(HWND(hwnd))
+        .and_then(|window| {
+            window.with_input_handler(|handler| handler.replace_text_in_range(None, text))
+        })
+        .is_some()
+}
+
+/// What the text field with the keys in GPUI's window `hwnd` has marked, in UTF-16.
+pub fn marked_range(hwnd: *mut std::ffi::c_void) -> Option<std::ops::Range<usize>> {
+    window_from_hwnd(HWND(hwnd))?
+        .with_input_handler(|handler| handler.marked_text_range())
+        .flatten()
+}
