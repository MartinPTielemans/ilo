+/// The first window's pipelines, which `make_early` makes with the devices, and the device they're
+/// for: a window whose device is another, after the device was lost, makes its own.
+static EARLY_PIPELINES: std::sync::Mutex<Option<(ID3D11Device, DirectXRenderPipelines)>> =
+    std::sync::Mutex::new(None);
+
+/// Makes the first window's pipelines on `device` now, off the main thread, for its renderer to
+/// take: they need only the device, and cost the main thread ~3 ms as the window opens.
+pub(crate) fn make_pipelines_early(device: &ID3D11Device) {
+    let Ok(pipelines) = DirectXRenderPipelines::new(device) else {
+        return;
+    };
+    if let Ok(mut early) = EARLY_PIPELINES.lock() {
+        *early = Some((device.clone(), pipelines));
+    }
+}
+
+fn take_early_pipelines(device: &ID3D11Device) -> Option<DirectXRenderPipelines> {
+    let (made_on, pipelines) = EARLY_PIPELINES.lock().ok()?.take()?;
+    (made_on == *device).then_some(pipelines)
+}
