+/// How long a window keeps getting frames after it last asked for one. Every input that draws asks
+/// again, so this only bridges a stream's gaps and the frame after it, as on the Mac.
+const FRAME_RUN_ON: Duration = Duration::from_millis(200);
+
+static FRAME_EPOCH: LazyLock<Instant> = LazyLock::new(Instant::now);
+
+/// The vsync thread, which parks while no window wants a frame.
+pub(crate) static VSYNC_THREAD: Mutex<Option<Thread>> = Mutex::new(None);
+
+/// When a window last asked for a frame. GPUI asks through `frame_waker` whenever the window turns
+/// dirty or wants another frame, so an idle window never wakes the vsync thread, nor the app's main
+/// thread with a paint, at the display's rate.
+pub(crate) struct FrameWant {
+    /// Milliseconds after `FRAME_EPOCH`, plus one so that 0 means never.
+    at: AtomicU64,
+}
+
+impl FrameWant {
+    pub(crate) fn new() -> Self {
+        Self {
+            at: AtomicU64::new(0),
+        }
+    }
+
+    pub(crate) fn wake(&self) {
+        self.at
+            .store(FRAME_EPOCH.elapsed().as_millis() as u64 + 1, Ordering::Release);
+        if let Some(thread) = VSYNC_THREAD.lock().unwrap().as_ref() {
+            thread.unpark();
+        }
+    }
+
+    pub(crate) fn wanted(&self) -> bool {
+        let at = self.at.load(Ordering::Acquire);
+        at != 0
+            && FRAME_EPOCH.elapsed().as_millis() as u64 + 1 - at <= FRAME_RUN_ON.as_millis() as u64
+    }
+}
