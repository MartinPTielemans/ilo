+
+impl FrameWant {
+    pub(crate) fn new() -> Self {
+        Self {
+            at: AtomicU64::new(0),
+            queued: AtomicU64::new(0),
+        }
+    }
+
+    /// Notes a frame message as posted; false if one already is, and not lost.
+    pub(crate) fn queue(&self) -> bool {
+        let now = FRAME_EPOCH.elapsed().as_millis() as u64 + 1;
+        let posted = self.queued.load(Ordering::Acquire);
+        if posted != 0 && now - posted <= FRAME_RUN_ON.as_millis() as u64 {
+            return false;
+        }
+        self.queued.store(now, Ordering::Release);
+        true
+    }
+
+    /// The posted frame message has come, or wasn't posted.
+    pub(crate) fn unqueue(&self) {
+        self.queued.store(0, Ordering::Release);
+    }
+
+    pub(crate) fn wake(&self) {
+        self.at
+            .store(FRAME_EPOCH.elapsed().as_millis() as u64 + 1, Ordering::Release);
+        if let Some(thread) = VSYNC_THREAD.lock().unwrap().as_ref() {
+            thread.unpark();
+        }
+    }
+
+    pub(crate) fn wanted(&self) -> bool {
+        let at = self.at.load(Ordering::Acquire);
+        at != 0
+            && FRAME_EPOCH.elapsed().as_millis() as u64 + 1 - at <= FRAME_RUN_ON.as_millis() as u64
