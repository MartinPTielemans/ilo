+/// so a removal while the thread is parked is recovered from before the next input.
+struct DeviceRemovedWake {
+    event: HANDLE,
+    wait: HANDLE,
+    watched: Option<(ID3D11Device4, u32)>,
+}
+
+impl DeviceRemovedWake {
+    fn new() -> Option<Self> {
+        unsafe {
+            let event = CreateEventW(None, false, false, None).log_err()?;
+            let mut wait = HANDLE::default();
+            if RegisterWaitForSingleObject(
+                &mut wait,
+                event,
+                Some(wake_vsync_thread),
+                None,
+                INFINITE,
+                WT_EXECUTEDEFAULT,
+            )
+            .log_err()
+            .is_none()
+            {
+                CloseHandle(event).log_err();
+                return None;
+            }
+            Some(Self {
+                event,
+                wait,
+                watched: None,
+            })
+        }
+    }
+
+    /// Watches `device` in place of the one before, which a recovery replaced.
+    fn watch(&mut self, device: &ID3D11Device) {
