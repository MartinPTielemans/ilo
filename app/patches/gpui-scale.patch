+/// Input a window can't take yet, as it comes while the App is in an update or while the window's
+/// callback is out, which a nested event pump delivers (#2658). Dropped, a press or release makes a
+/// click do nothing, so it waits, and what the pointer does after it waits behind it, in order, to
+/// be handed on once the window can take it. Keys aren't held: whether one is handled decides
+/// where it goes next, which has to be answered now.
+#[derive(Default)]
+pub struct HeldInput(std::collections::VecDeque<PlatformInput>);
+
+impl HeldInput {
+    /// Holds `event` if it's a press or release, or anything but a key behind one held already;
+    /// otherwise gives it back.
+    pub fn hold(&mut self, event: PlatformInput) -> Option<PlatformInput> {
+        let held = match event {
+            PlatformInput::KeyDown(_) | PlatformInput::KeyUp(_) | PlatformInput::ModifiersChanged(_) => false,
+            PlatformInput::MouseDown(_) | PlatformInput::MouseUp(_) => true,
+            _ => !self.0.is_empty(),
+        };
+        if !held {
+            return Some(event);
+        }
+        self.0.push_back(event);
+        None
+    }
+
+    /// The input that came first of what's held.
+    pub fn next(&mut self) -> Option<PlatformInput> {
+        self.0.pop_front()
+    }
+
+    /// Whether anything waits.
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+}
